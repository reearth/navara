{
  "name": "@navaramap/three-react",
  "type": "module",
  "version": "0.0.0",
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "type-check": "tsc && tsc -p tsconfig.node.json",
    "build": "pnpm type-check && vite build --watch=false",
    "build:dev": "vite build --mode development",
    "build:dev:watch": "pnpm build:dev --watch",
    "test": "vitest --passWithNoTests --watch=false",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write --ignore-path ../../.gitignore --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.gitignore --ignore-path ../../.prettierignore ."
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reearth/navara.git",
    "directory": "web/navara_three_react"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@navaramap/three": "workspace:*",
    "react": ">=19",
    "three": ">=0.183.0"
  },
  "devDependencies": {
    "@navaramap/three": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "three": "0.185.1"
  }
}
