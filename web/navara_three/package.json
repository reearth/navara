{
  "name": "@navaramap/three",
  "type": "module",
  "version": "0.0.0",
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "start": "vite",
    "dev": "vite -c vite.config.example.ts --host",
    "type-check": "tsc && tsc -p tsconfig.node.json",
    "build": "pnpm type-check && vite build -c vite.config.ts",
    "build:dev": "vite build --mode development",
    "build:dev:watch": "pnpm build:dev --watch",
    "build:iife": "vite build -c vite.config.iife.ts",
    "build:example": "tsc && vite build -c vite.config.example.ts",
    "preview": "vite preview",
    "test": "vitest --passWithNoTests --watch=false",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write --ignore-path ../../.gitignore --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.gitignore --ignore-path ../../.prettierignore .",
    "screenshots": "tsx scripts/generate-screenshots.ts"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reearth/navara.git",
    "directory": "web/navara_three"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "postprocessing": ">=6.38.0",
    "three": ">=0.183.0"
  },
  "dependencies": {
    "@navaramap/core": "workspace:*",
    "@navaramap/engine": "workspace:*",
    "@navaramap/engine-api": "workspace:*",
    "@navaramap/font": "workspace:*",
    "@navaramap/three-api": "workspace:*",
    "@navaramap/three-csm": "workspace:*",
    "@navaramap/worker": "workspace:*",
    "@takram/three-atmosphere": "0.19.1",
    "@takram/three-clouds": "0.7.6",
    "@takram/three-geospatial": "0.9.1",
    "@takram/three-geospatial-effects": "0.6.4",
    "astronomy-engine": "2.1.19",
    "stats.js": "0.17.0",
    "three-stdlib": "2.36.1"
  },
  "devDependencies": {
    "@navaramap/three-default-descs": "workspace:*",
    "@navaramap/three-default-plugin": "workspace:*",
    "@navaramap/three-plugins": "workspace:*",
    "@navaramap/three-react": "workspace:*",
    "@playwright/test": "1.61.1",
    "@radix-ui/react-collapsible": "1.1.17",
    "@radix-ui/react-label": "2.1.12",
    "@radix-ui/react-select": "2.3.4",
    "@radix-ui/react-separator": "1.1.12",
    "@radix-ui/react-slider": "1.4.4",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-switch": "1.3.4",
    "@tailwindcss/postcss": "4.3.3",
    "@tweakpane/core": "2.0.5",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.1.1",
    "@types/stats.js": "0.17.4",
    "@types/three": "0.185.1",
    "ajv": "8.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.21",
    "lucide-react": "1.25.0",
    "playwright": "1.61.1",
    "postcss": "8.5.20",
    "postprocessing": "6.39.3",
    "sharp": "0.35.3",
    "shiki": "4.3.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "three": "0.185.1",
    "tsx": "4.23.1",
    "tweakpane": "4.0.5",
