                  [138.76231, 35.349328],
                  [138.76231, 35.317328]
                ]
              ]
            }
          },
          {
            "type": "Feature",
            "properties": {
              "name": "Polygon D",
              "type": "polygon",
              "color": "#0000ff",
              "No": 4
            },
            "geometry": {
              "type": "Polygon",
              "coordinates": [
                [
                  [138.803455, 35.317328],
                  [138.835455, 35.317328],
