{
  "version": 8,
  "terrain": {
    "source": "mapterhorn-dem"
  },
  "sources": {
    "osm": {
      "type": "raster",
      "tiles": ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
      "tileSize": 256,
      "maxzoom": 19
    },
    "mapterhorn-dem": {
      "type": "raster-dem",
      "tiles": ["https://tiles.mapterhorn.com/{z}/{x}/{y}.webp"],
      "tileSize": 512,
      "maxzoom": 15,
      "encoding": "terrarium"
    },
    "mvt-fire-prevention": {
      "type": "vector",
      "tiles": ["https://assets.cms.plateau.reearth.io/assets/d9/5ce2d6-0aa8-4a17-a86a-028c2dc2b817/13_tokyo_pref_2023_citygml_1_op_urf_FirePreventionDistrict_mvt_lod1/{z}/{x}/{y}.mvt"],
      "maxzoom": 16
    },
    "mvt-gifu-roads": {
      "type": "vector",
      "tiles": ["https://assets.cms.plateau.reearth.io/assets/67/b5b3c6-71d8-405c-88c8-4ead72890b2b/21201_gifu-shi_city_2023_citygml_1_op_tran_mvt_lod0/{z}/{x}/{y}.mvt"],
      "maxzoom": 16
    },
    "mvt-wakayama-gen": {
      "type": "vector",
      "tiles": ["https://assets.cms.plateau.reearth.io/assets/d4/ee889d-98b4-4425-a5b6-c60bf36e2e5a/30201_wakayama-shi_city_2023_citygml_1_op_gen_20_mvt_lod0/{z}/{x}/{y}.mvt"],
      "maxzoom": 16
    },
    "extruded-polygon": {
      "type": "geojson",
      "data": "/interior.geojson"
    },
    "simple-polygon": {
      "type": "geojson",
      "data": {
