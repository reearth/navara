            },
            "geometry": {
              "type": "Point",
              "coordinates": [138.8, 35.28]
            }
          }
        ]
      }
    }
  },
  "layers": [
    {
      "id": "osm-basemap",
      "type": "raster",
      "source": "osm",
      "paint": {
        "raster-opacity": 1.0
      }
    },
    {
      "id": "mapterhorn-hillshade",
      "type": "hillshade",
      "source": "mapterhorn-dem",
      "paint": {
        "hillshade-exaggeration": 1.0
      }
    },
    {
      "id": "fire-prevention",
      "type": "fill",
      "source": "mvt-fire-prevention",
      "source-layer": "FirePreventionDistrict",
      "paint": {
        "fill-color": [
          "match",
          ["get", "urf_function"],
          "防火地域",
          "#0000ff",
          "準防火地域",
          "#00ff00",
          "#ffffff"
        ],
        "fill-opacity": 0.6
      }
    },
    {
      "id": "gifu-roads",
      "type": "line",
      "source": "mvt-gifu-roads",
      "source-layer": "Transportation",
      "paint": {
        "line-color": "#ff0000",
        "line-width": 10
      }
    },
    {
      "id": "wakayama-heliports",
      "type": "circle",
      "source": "mvt-wakayama-gen",
      "source-layer": "Gen",
      "paint": {
        "circle-color": [
          "match",
          ["get", "備考"],
          "陸上競技場",
          "#0000ff",
          "#ff0000"
        ],
        "circle-radius": [
          "match",
          ["get", "備考"],
          "陸上競技場",
          1000,
          500
        ]
      }
    },
    {
      "id": "extruded-buildings",
      "type": "fill-extrusion",
      "source": "extruded-polygon",
      "paint": {
        "fill-extrusion-color": ["get", "color"],
        "fill-extrusion-opacity": 1.0,
        "fill-extrusion-base": ["get", "height"],
        "fill-extrusion-height": ["get", "extrudedHeight"]
      }
    },
    {
      "id": "polygon-fill",
      "type": "fill",
      "source": "simple-polygon",
      "filter": [">", ["get", "No"], 0],
      "paint": {
        "fill-color": [
          "case",
          [
            "!=",
            [
              "-",
              ["get", "No"],
              ["*", ["floor", ["/", ["get", "No"], 2]], 2]
            ],
            0
          ],
          "#bf61f6",
          "#0062ff"
        ]
      }
    },
    {
      "id": "symbol-both",
      "type": "symbol",
      "source": "symbol-test-points",
      "layout": {
        "icon-image": ["get", "icon"],
        "icon-size": ["get", "iconSize"],
        "text-field": ["get", "name"],
        "text-font": ["/fonts/lineseedjp/LINESeedJP-Bold.ttf"],
        "text-size": ["get", "textSize"]
      },
      "paint": {
        "icon-color": "#ffffff",
        "icon-opacity": 1.0,
        "text-color": ["get", "color"],
        "text-opacity": 1.0
      }
    }
  ]
}
