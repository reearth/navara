    },
    "symbol-test-points": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": [
          {
            "type": "Feature",
            "properties": {
              "name": "Tokyo",
              "icon": "/icons/restaurant.svg",
              "color": "#ff0000",
              "textSize": 40,
              "iconSize": 60
            },
            "geometry": {
              "type": "Point",
              "coordinates": [138.7, 35.28]
            }
          },
          {
            "type": "Feature",
            "properties": {
              "name": "Osaka",
              "icon": "/icons/cafe.svg",
              "color": "#00ff00",
              "textSize": 30,
              "iconSize": 50
            },
            "geometry": {
              "type": "Point",
              "coordinates": [138.75, 35.28]
            }
          },
          {
            "type": "Feature",
            "properties": {
              "name": "Kyoto",
              "icon": "/icons/hotel.svg",
              "color": "#0000ff",
              "textSize": 20,
