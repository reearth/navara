      }
      .lp-tile-wide {
        grid-column: span 2;
        height: min(44vw, 704px);
      }
      .lp-tile-half {
        height: min(30vw, 480px);
      }
      /* 60-column grid so rows can mix 3:2 (36+24), 1:1:1 (20+20+20),
         2:3 (24+36), and 1:1:1:1 (15x4) — one distinct split per row. */
      .lp-example-grid {
        display: grid;
        grid-template-columns: repeat(60, 1fr);
        grid-auto-rows: min(32vw, 512px);
        gap: 2px;
        margin-top: 2px;
        background: var(--sub);
      }
      .lp-span-15 {
        grid-column: span 15;
      }
      .lp-span-20 {
        grid-column: span 20;
      }
      .lp-span-24 {
        grid-column: span 24;
      }
      .lp-span-36 {
        grid-column: span 36;
      }

      /* MapLibre family */
      .lp-maplibre {
        padding: 80px 48px;
        background: var(--ml);
        color: #fff;
      }
      .lp-maplibre-grid {
        display: grid;
        grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
        gap: 48px;
        align-items: center;
      }
      .lp-maplibre-brand {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .lp-maplibre-logo {
        width: 40px;
        height: 40px;
        flex: none;
      }
      .lp-maplibre-logo-placeholder {
        border: 1px dashed color-mix(in oklab, var(--ml), white 40%);
        border-radius: 8px;
        box-sizing: border-box;
      }
      .lp-maplibre-h2 {
        margin: 10px 0 16px;
        font: 700 34px "Arsenal", "Zen Kaku Gothic New", sans-serif;
      }
      .lp-maplibre-copy {
        margin-bottom: 24px;
        font-size: 15px;
        line-height: 2;
        color: color-mix(in oklab, var(--ml), white 80%);
        text-wrap: pretty;
      }
      .lp-maplibre-list {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 12px;
        font-size: 14px;
      }
      .lp-maplibre-list li {
        display: flex;
        gap: 10px;
      }
      .lp-maplibre-list li span {
        color: color-mix(in oklab, var(--ml), white 60%);
      }
      .lp-maplibre-roadmap {
        margin-top: 22px;
        font-size: 13px;
      }
      .lp .lp-maplibre-roadmap a {
        color: #fff;
        text-decoration: underline;
      }
      .lp .lp-maplibre-roadmap a:hover {
        color: color-mix(in oklab, var(--ml), white 70%);
      }
      .lp-maplibre-visual {
        position: relative;
        min-height: 320px;
        /* Clip the reveal scale-settle to the rounded frame. */
        overflow: hidden;
        border-radius: 14px;
      }
      .lp-maplibre-visual img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 14px;
      }

      /* Who's building with Navara */
      .lp-users {
        padding: 80px 48px;
        background: var(--sub);
      }
      .lp-users-sub {
        margin-bottom: 36px;
        font-size: 15px;
        color: var(--ink-soft);
      }
      .lp-users-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
      }
      .lp-user-visual {
        position: relative;
        height: 190px;
      }
      .lp-user-visual img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .lp-users-grid b {
        display: block;
        margin-top: 18px;
        font-size: 16px;
      }
      .lp-users-grid > div > p {
        margin-top: 8px;
        font-size: 13px;
        line-height: 1.9;
        color: var(--ink-soft);
      }

      /* Get started (footer) */
      .lp-footer {
        padding: 88px 48px 56px;
        background: var(--pri);
        color: var(--on-dark);
        text-align: center;
      }
      .lp-footer h2 {
        font: 700 40px "Arsenal", "Zen Kaku Gothic New", sans-serif;
      }
      .lp a.lp-footer-cta {
        margin-top: 26px;
        display: inline-block;
        background: var(--on-dark);
        color: var(--pri);
        padding: 12px 26px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 14px;
      }
      .lp a.lp-footer-cta:hover {
        background: var(--acc);
        color: var(--pri);
      }
      .lp-footer-links {
        display: flex;
        justify-content: center;
        gap: 26px;
        margin-top: 30px;
        font-size: 14px;
        font-weight: 500;
      }
      .lp .lp-footer-links a {
        color: var(--on-dark);
      }
      .lp .lp-footer-links a:hover {
        color: var(--acc);
      }
      .lp-footer-credit {
        margin-top: 44px;
        font-size: 12px;
        color: var(--on-dark-soft);
      }

      /* Responsive — the desktop composition is the reference; tablets tighten
         spacing and stack the widest grids, phones stack everything and turn
         the gallery into a horizontal scroller that preserves the desktop
         layout at a fixed 900px composition width. */
      @media (max-width: 960px) {
        .lp-header {
          padding: 18px 28px;
        }
        .lp-intro {
          padding: 64px 32px 56px;
        }
        .lp-intro-grid {
          grid-template-columns: 1fr;
          gap: 36px;
        }
        .lp-intro-right {
          padding-top: 0;
        }
        .lp-why {
          padding: 80px 32px;
        }
        .lp-values {
          grid-template-columns: 1fr 1fr;
          row-gap: 36px;
        }
        .lp-api-grid {
          grid-template-columns: 1fr 1fr;
        }
        .lp-arch {
          padding: 64px 32px;
        }
        .lp-gallery-head {
          padding: 64px 32px 40px;
        }
        .lp-maplibre {
          padding: 64px 32px;
        }
        .lp-maplibre-grid {
          grid-template-columns: 1fr;
          gap: 36px;
        }
        .lp-users {
          padding: 64px 32px;
        }
        .lp-users-grid {
          grid-template-columns: 1fr;
          gap: 36px;
        }
        .lp-user-visual {
          height: min(48vw, 320px);
        }
        .lp-footer {
          padding: 72px 32px 48px;
        }
      }

      @media (max-width: 640px) {
        .lp-header {
          padding: 14px 20px;
        }
        .lp-nav {
          gap: 18px;
        }
        /* Docs/Examples text links don't fit; both stay reachable from the
           footer. */
        .lp-nav > a:not([class]) {
          display: none;
        }
        .lp-wordmark {
          font-size: 19px;
        }
        .lp .lp-nav a.lp-nav-cta {
          padding: 7px 14px;
          font-size: 13px;
        }

        .lp-intro {
          padding: 48px 20px 44px;
        }
        .lp-h1 {
          font-size: 34px;
        }
        .lp-h1-sub {
          margin-top: 14px;
          font-size: 14px;
        }

        .lp-why {
          padding: 64px 20px;
        }
        .lp-why-h2 {
          margin-top: 12px;
          font-size: 27px;
          line-height: 1.45;
        }
        .lp-values {
          grid-template-columns: 1fr;
          gap: 28px;
          margin-top: 48px;
        }
        .lp-values > div {
          padding: 0 0 0 18px;
        }
        .lp-api-band {
          margin-top: 56px;
          padding: 26px 20px;
          border-radius: 12px;
        }
        .lp-api-head {
          flex-direction: column;
          align-items: flex-start;
          gap: 6px;
          margin-bottom: 20px;
        }
        .lp-api-grid {
          grid-template-columns: 1fr;
        }
        .lp-api-note {
          text-align: left;
        }

        .lp-arch {
          padding: 64px 20px;
        }
        .lp-h2 {
          font-size: 24px;
        }
        .lp-arch-sub {
          margin-bottom: 32px;
        }
        .lp-arch-targets {
          grid-template-columns: 1fr;
          gap: 10px;
        }

        .lp-gallery-head {
          padding: 56px 20px 28px;
        }
        /* The grids keep their desktop composition at 900px and the overflow
           scrolls sideways; the label overlay lives outside the scroller, so
           it stays pinned to the viewport edge while images pass under it. */
        .lp-gallery-scroll {
          overflow-x: auto;
          scrollbar-width: none;
        }
        .lp-gallery-scroll::-webkit-scrollbar {
          display: none;
        }
        .lp-tutorial-grid,
        .lp-example-grid {
          width: 900px;
        }
        .lp-tile-wide {
          height: 396px;
        }
        .lp-tile-half {
          height: 270px;
        }
        .lp-example-grid {
          grid-auto-rows: 288px;
        }
        .lp-gallery-side-inner {
          margin: 20px 0 20px 16px;
          bottom: 20px;
        }
        .lp-gallery-label {
          font-size: 13px;
          letter-spacing: 0.3em;
        }
        .lp-gallery-link {
          margin-top: 18px;
          font-size: 13px;
        }

        .lp-maplibre {
          padding: 64px 20px;
        }
        .lp-maplibre-h2 {
          font-size: 24px;
        }
        .lp-maplibre-visual {
          min-height: 220px;
        }

        .lp-users {
          padding: 64px 20px;
        }
        .lp-users-sub {
          margin-bottom: 28px;
        }

        .lp-footer {
          padding: 64px 20px 44px;
        }
        .lp-footer h2 {
          font-size: 28px;
        }
        .lp-footer-links {
          flex-wrap: wrap;
          gap: 18px 22px;
        }
      }
    </style>
  </body>
