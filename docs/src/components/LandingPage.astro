        [data-reveal].lp-revealed,
        .lp-revealed[data-reveal-group] > * {
          opacity: 1;
          transform: none;
        }
        .lp-revealed[data-motion="img"] img,
        .lp-revealed[data-reveal-group] > [data-motion="img"] img {
          transform: none;
        }
      }

      /* Header: always fixed; gains a dark backdrop once the hero is gone
