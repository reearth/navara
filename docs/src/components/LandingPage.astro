      }

      /* Eyebrow labels */
      .lp-eyebrow {
        font: 500 13px "IBM Plex Mono", monospace;
        color: color-mix(in oklab, var(--acc), black 25%);
        letter-spacing: 0.12em;
      }
      .lp-eyebrow-center {
