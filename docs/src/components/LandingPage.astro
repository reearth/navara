---
// Landing page for Navara. Design reference: design_handoff_navara_landing_page.
// Theme colors, image slots, and external links are managed in src/data/lp.json;
// all copy lives in src/data/lp-locales/<locale>.json. To add a locale, create
// its strings file there and a page that renders <LandingPage locale="..." />.
// Image `src` values are repo-root-relative paths pointing into docs/src/assets
// or web/navara_three/example/public/screenshots.
import type { ImageMetadata } from "astro";
import { Code } from "astro:components";
import { ArrowUpRight, Check, ChevronDown, Globe, Maximize2, Play } from "@lucide/astro";
import lp from "../data/lp.json";
import ImageAttribution from "./ImageAttribution.astro";
import GalleryTile from "./GalleryTile.astro";
import googleMapsLogo from "../assets/lp/google-maps-logo.png";
import githubIcon from "../assets/lp/github-invertocat.svg?raw";
import archGlobe from "../assets/lp/arch-globe.svg?url";
import archTerrain from "../assets/lp/arch-terrain.svg?url";
import archBuildings from "../assets/lp/arch-buildings.svg?url";
import archMarker from "../assets/lp/arch-marker.svg?url";
import archArrow from "../assets/lp/arch-arrow.svg?url";

interface Props {
  locale: string;
}

// The root locale is served at "/" without a path prefix (matches Starlight).
const ROOT_LOCALE = "en";

const localeModules = import.meta.glob<{ default: any }>("../data/lp-locales/*.json", {
  eager: true,
});
const locales: Record<string, any> = {};
for (const [path, mod] of Object.entries(localeModules)) {
  const code = path.match(/([\w-]+)\.json$/)?.[1];
  if (code) locales[code] = mod.default;
}

const { locale } = Astro.props;
const t = locales[locale];
if (!t) throw new Error(`LP locale strings not found: ${locale}`);

// Prefix internal links with the locale path segment (root locale has none).
function localizeHref(href: string): string {
  if (!href.startsWith("/") || locale === ROOT_LOCALE) return href;
  return `/${locale}${href}`;
}
// Pre-release the LP is parked under /lp (the docs top pages own the locale
// roots); at release this returns to the locale roots — see astro.config.mjs.
const lpPathOf = (code: string): string => (code === ROOT_LOCALE ? "/lp/" : `/${code}/lp/`);

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  [
    "../assets/**/*.{png,jpg,jpeg,gif,webp,avif,svg}",
    "../../../web/navara_three/example/public/screenshots/**/*.{png,jpg,jpeg,gif,webp,avif}",
  ],
  { eager: true },
);

interface ImageSlot {
  src: string | null;
  href?: string;
}

// Resolve a repo-root-relative path from lp.json to a bundled asset URL.
function resolveImage(imageSlot: ImageSlot): string | null {
  if (!imageSlot.src) return null;
  const key = imageSlot.src.startsWith("docs/src/")
    ? imageSlot.src.replace("docs/src/", "../")
    : `../../../${imageSlot.src}`;
  const mod = imageModules[key];
  if (!mod) throw new Error(`LP image not found: ${imageSlot.src}`);
  return mod.default.src;
}

const images = lp.images as Record<string, ImageSlot>;
const slot = (id: string): ImageSlot => {
  const s = images[id];
  if (!s) throw new Error(`LP image slot not defined in lp.json: ${id}`);
  return s;
};
const src = (id: string): string | null => resolveImage(slot(id));
// Alt text is copy, so it lives with the locale strings (imageAlts, keyed by slot id).
const alt = (id: string): string => {
  const text = t.imageAlts?.[id];
  if (text === undefined) throw new Error(`LP image alt not defined for locale "${locale}": ${id}`);
  return text;
};

const { colors, links } = lp;
const rootStyle = `--pri:${colors.primary};--acc:${colors.accent};--sub:${colors.sub};--ml:${colors.maplibre}`;

// Attribution credits (text + link to each source's terms). The strings are
// language-agnostic, so they live here rather than duplicated per locale; only
// the button label is translated (via `mediaAttributionLabel`).
const SRC = {
  gsiPhoto: {
    text: "Geospatial Information Authority of Japan Tiles - Latest Nationwide Photo (Seamless)",
    href: "https://maps.gsi.go.jp/development/ichiran.html",
  },
  gsiDem: {
    text: "Geospatial Information Authority of Japan Tiles - Digital Elevation Map",
    href: "https://maps.gsi.go.jp/development/ichiran.html",
  },
  gsiVector: {
    text: "Geospatial Information Authority of Japan Vector Tile Experimental Service",
    href: "https://github.com/gsi-cyberjapan/gsimaps-vector-experiment",
  },
  plateauChiyoda: {
    text: "3D City Model (Project PLATEAU) Chiyoda Ward (FY2023) - MLIT PLATEAU",
    href: "https://www.geospatial.jp/ckan/dataset/plateau-13101-chiyoda-ku-2023",
  },
  plateauTakanawa: {
    text: "[UC23-11] Advanced Area Management Using Storytelling GIS - MLIT PLATEAU",
    href: "https://www.geospatial.jp/ckan/dataset/plateau-uc23-11",
  },
  plateauGeneric: {
    text: "3D City Model (Project PLATEAU) - MLIT",
    href: "https://www.mlit.go.jp/plateau/",
  },
  nasaNight: {
    text: "NASA Earth at Night imagery - NASA Earth Observatory",
    href: "https://earthobservatory.nasa.gov/features/NightLights",
  },
  nasaBlackMarble: {
    text: "NASA Earth Observatory - Suomi NPP VIIRS - Black Marble 2016",
    href: "https://science.nasa.gov/earth/earth-observatory/earth-at-night/maps",
  },
  nasaGibs: {
    text: "Imagery courtesy of NASA EOSDIS GIBS - Blue Marble: Next Generation (public domain)",
    href: "https://earthdata.nasa.gov/gibs",
  },
  google: {
    text: "Google Maps Photorealistic 3D Tiles",
    href: "https://www.google.com/permissions/geoguidelines/",
  },
  mapterhorn: { text: "© Mapterhorn", href: "https://mapterhorn.com/attribution" },
  reearthTerrain: { text: "Re:Earth Terrain", href: "https://terrain.reearth.land/" },
  reearthPapers: { text: "Re:Earth Papers", href: "https://papers.reearth.land" },
  protomaps: { text: "© Protomaps", href: "https://protomaps.com" },
  protomapsPlain: { text: "Protomaps", href: "https://protomaps.com" },
  osm: {
    text: "© OpenStreetMap contributors",
    href: "https://www.openstreetmap.org/copyright",
  },
  fox: {
    text: "Fox by PixelMannen (CC0), rig & animation by tomkranis (CC BY 4.0) - Khronos glTF Sample Assets",
    href: "https://github.com/KhronosGroup/glTF-Sample-Assets/tree/main/Models/Fox",
  },
  lantern: {
    text: "Lantern by Microsoft & Frank Galligan (CC0) - Khronos glTF Sample Assets",
    href: "https://github.com/KhronosGroup/glTF-Sample-Assets/tree/main/Models/Lantern",
  },
  muscleCar: {
    text: "Classic Muscle car by Lexyc16 (CC BY 4.0)",
    href: "https://sketchfab.com/3d-models/classic-muscle-car-641efc889e5f4543bae51d0922e6f4b3",
  },
  sunnyMeadow: {
    text: "Sunny Meadow by Jeremias Kieferle - CC BY 4.0",
    href: "https://assets.cms.reearth.io/assets/e2/e8e117-8059-4450-adde-7fa7a3c5908a/Sunny Meadow/LICENSE",
  },
} as const;

// Which sources each gallery image draws on. `attrib(id)` resolves them to the
// credit objects ImageAttribution renders.
const TILE_SOURCES: Record<string, (keyof typeof SRC)[]> = {
  "tutorial-wide": ["gsiPhoto", "gsiDem", "gsiVector", "plateauChiyoda"],
  "tutorial-left": ["gsiPhoto", "nasaNight"],
  "tutorial-right": ["plateauTakanawa", "gsiDem", "gsiPhoto"],
  "example-row1-left": ["google"],
  "example-row1-right": ["mapterhorn", "gsiPhoto"],
  "example-row2-left": ["reearthPapers", "fox"],
  "example-row2-center": ["google"],
  "example-row2-right": ["reearthPapers"],
  "example-row3-left": ["reearthPapers", "lantern"],
  "example-row3-right": ["google"],
  "example-row4-left": ["reearthPapers", "sunnyMeadow"],
  "example-row4-center-left": ["reearthPapers", "osm"],
  "example-row4-center-right": ["reearthPapers", "muscleCar"],
  "example-row4-right": ["reearthPapers", "osm"],
};
const attrib = (id: string) => (TILE_SOURCES[id] ?? []).map((k) => SRC[k]);
const galleryAttribLabel = t.gallery.mediaAttributionLabel;
const googleLogoSrc = googleMapsLogo.src;

// The "4 API tiers" showcase still and the MapLibre still, credited inline.
const whyAttrib = [
  SRC.plateauGeneric,
  SRC.reearthTerrain,
  SRC.reearthPapers,
  SRC.protomapsPlain,
  SRC.osm,
];
const maplibreAttrib = [SRC.osm, SRC.protomaps];

// The MapLibre-family section is parked until its story (style plugin / MLT)
// is further along; flip to true to bring it back.
const SHOW_MAPLIBRE = false;

// Hello world: the entire first program, shown whole in the HELLO WORLD
// section. A TileJSON-based take on the docs' Getting Started example
// (guides/Introduction/getting-started.mdx) — the TileJSON document supplies
// the tile URL, zoom range, and data attribution, which keeps the program
// short without dropping the credits. Every API call is real; verify against
// the docs before editing.
const helloCode = `// Initialization
const view = new ThreeView({ useNormal: true });
const defaultPlugin = new DefaultPlugin();
const tilejson = new TileJsonPlugin();
view.addPlugin(defaultPlugin);
view.addPlugin(tilejson);
await view.init();

// Setting up default atmosphere
defaultPlugin.addDefaultPhotorealScene();
view.atmosphere.date = new Date("2026-07-16T01:00:00Z");
view.toneMappingExposure = 10;

// Raster tile
const source = await tilejson.addSource({
  type: "raster-tile",
  url: "https://papers.reearth.land/bluemarble/tilejson.json",
});
view.addLayer({ type: "raster", source });`;

const helloAttrib = [SRC.nasaGibs, SRC.reearthPapers];
const outroAttrib = [SRC.nasaBlackMarble, SRC.reearthPapers];
---

<html lang={t.htmlLang} style={rootStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    {/* TODO: Remove when Navara is released. */}
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Arsenal:wght@400;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="lp">
      <!-- Transparent header over hero -->
      <header class="lp-header">
        <span class="lp-wordmark">NAVARA</span>
        <nav class="lp-nav">
          <a href={localizeHref(links.docs)}>{t.nav.docs}</a>
          <a href={links.examples}>{t.nav.examples}</a>
          <a
            class="lp-nav-github"
            href={links.github}
            aria-label={t.nav.github}
            set:html={githubIcon}
          />
          <label class="lp-lang">
            <Globe size={16} stroke-width={1.8} aria-hidden="true" />
            <span class="lp-lang-label" aria-hidden="true">{t.short}</span>
            <ChevronDown class="lp-lang-chevron" size={14} stroke-width={2} aria-hidden="true" />
            <!-- Invisible select stretched over the whole switcher, so a
                 click anywhere on it opens the native dropdown. -->
            <select aria-label="Language" data-lp-lang>
              {
                Object.entries(locales).map(([code, strings]: [string, any]) => (
                  <option value={lpPathOf(code)} selected={code === locale} lang={strings.htmlLang}>
                    {strings.short}
                  </option>
                ))
              }
            </select>
          </label>
        </nav>
      </header>

      <!-- Hero stage: the hero image stays pinned while the transparent
           catch-copy section slides up over it; once that section is fully
           visible the page scrolls normally again. -->
      <div class="lp-hero-stage">
        <!-- Hero: the promo video loops behind the catch copy. An AVIF still
             (the video's own first frame) paints first and plays the opening
             animation; the video fades in over it once it is actually
             rolling, so there is never a black flash. Phones get the smaller
             encode plus a fullscreen button (the portrait crop hides most of
             the frame; fullscreen shows it all). Sources are picked by the
             script below; without JS (or with reduced motion) the still
             simply stays. -->
        <div class="lp-hero">
          <picture>
            <source media="(max-width: 640px)" srcset="/promo/promo-poster-sp.avif" type="image/avif" />
            <img src="/promo/promo-poster.avif" alt={t.hero.posterAlt} />
          </picture>
          <video
            class="lp-hero-video"
            muted
            loop
            playsinline
            preload="auto"
            aria-hidden="true"
            data-src="/promo/navara-promo.mp4"
            data-src-sp="/promo/navara-promo-sp.mp4"
          ></video>
          <button class="lp-hero-fs" type="button" aria-label={t.hero.fullscreen}>
            <Maximize2 size={18} stroke-width={2} aria-hidden="true" />
          </button>
          <!-- Shown only when autoplay is refused (iOS Low Power Mode etc.):
               a play() from a tap is allowed even while autoplay is not. -->
          <button class="lp-hero-play" type="button" aria-label={t.hero.play}>
            <Play size={22} stroke-width={2} aria-hidden="true" />
          </button>
          <!-- Phone-only scroll cue: the full-viewport video gives no hint
               that the page continues; a pulsing chevron at the bottom center
               does, and fades out for good once scrolling starts. -->
          <div class="lp-hero-scroll-cue" aria-hidden="true">
            <ChevronDown size={22} stroke-width={2} />
          </div>
        </div>
        <!-- Catch copy + intro -->
        <section class="lp-intro">
        <div class="lp-container lp-intro-grid">
          <div>
            <h1 class="lp-h1" set:html={t.intro.h1Html} />
            {t.intro.h1Sub && <p class="lp-h1-sub">{t.intro.h1Sub}</p>}
          </div>
          <div class="lp-intro-right">
            <p class="lp-intro-copy" set:html={t.intro.copyHtml} />
            <div class="lp-cta-row">
              <a class="lp-btn-primary" href={links.examples}>{t.intro.ctaShowcase}</a>
              <a class="lp-btn-outline" href={localizeHref(links.docs)}>{t.intro.ctaDocs}</a>
            </div>
            <p class="lp-getting-started">
              <a href={localizeHref(links.gettingStarted)}
                >{t.intro.gettingStarted}<ArrowUpRight class="lp-link-icon" size={15} /></a
              >
            </p>
          </div>
        </div>
        </section>
      </div>

      <div class="lp-main">
      <!-- Why Navara -->
      <section class="lp-why">
        <div class="lp-container">
          <p class="lp-eyebrow lp-eyebrow-center" data-reveal>{t.why.eyebrow}</p>
          <h2 class="lp-why-h2" data-reveal style="--rd:1" set:html={t.why.h2Html} />
          <div class="lp-values" data-reveal-group>
            {
              t.why.values.map((value: any) => (
                <div>
                  <h3>{value.title}</h3>
                  <p>{value.desc}</p>
                </div>
              ))
            }
          </div>
          <!-- API tiers: one media showcase. The still cross-fades through
               the four tiers (why-tier-1..4); an editorial open ring sits in
               the corner with Declarative at its core and Plugin / API /
               Shader on the ring, and the caption + the glowing ring label
               highlight in sync. Auto-advances on screen; click a ring label
               to jump. Stills are lp.json slots, swappable without touching
               this markup. -->
          <div class="lp-api-tiers">
            <div class="lp-api-stage" data-reveal>
              <div class="lp-api-media">
                {
                  t.why.apiSegments.map((_seg: any, i: number) => (
                    <img
                      src={src(`why-tier-${i + 1}`)}
                      alt={alt(`why-tier-${i + 1}`)}
                      class={i === 0 ? "lp-tier-visible" : undefined}
                      loading="lazy"
                      decoding="async"
                    />
                  ))
                }
                <div class="lp-api-scrim" aria-hidden="true" />
                <div class="lp-api-lede">
                  <h3 class="lp-api-lede-title">{t.why.apiLede.title}</h3>
                  <p class="lp-api-lede-sub">{t.why.apiLede.sub}</p>
                </div>
                <ImageAttribution
                  items={whyAttrib}
                  label={t.why.mediaAttributionLabel}
                  corner="tr"
                />
                <div class="lp-api-caps">
                  {
                    t.why.apiSegments.map((seg: any, i: number) => (
                      <div
                        class={`lp-api-cap${i === 0 ? " lp-tier-active" : ""}`}
                      >
                        <p class="lp-api-cap-title">
                          {seg.label}
                          <span class="lp-api-cap-scene">{seg.scene}</span>
                        </p>
                        <p class="lp-api-cap-desc">{seg.desc}</p>
                      </div>
                    ))
                  }
                </div>
                <div class="lp-api-ring">
                  <svg viewBox="0 0 240 240" aria-hidden="true">
                    <path
                      class="lp-api-track"
                      d="M156 31 A96 96 0 0 1 208.4 157.5"
                    />
                    <path
                      class="lp-api-track"
                      d="M172.3 200.5 A96 96 0 0 1 77.9 206.3"
                    />
                    <path class="lp-api-track" d="M27.7 146.5 A96 96 0 0 1 84 31" />
                  </svg>
                  <button
                    type="button"
                    class="lp-api-node lp-node-dec lp-tier-active"
                    data-tier="0"
                  >
                    <span>{t.why.apiSegments[0].label}</span>
                  </button>
                  <button
                    type="button"
                    class="lp-api-node lp-node-plugin"
                    data-tier="1"
                  >
                    <span>{t.why.apiSegments[1].label}</span>
                  </button>
                  <button
                    type="button"
                    class="lp-api-node lp-node-api"
                    data-tier="2"
                  >
                    <span>{t.why.apiSegments[2].label}</span>
                  </button>
                  <button
                    type="button"
                    class="lp-api-node lp-node-shader"
                    data-tier="3"
                  >
                    <span>{t.why.apiSegments[3].label}</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Hello world: the whole first program beside its rendered result —
           the proof of the "a few lines" claim. Copy lives in the locale
           JSONs (t.hello); the snippet itself is language-agnostic and lives
           in the frontmatter (helloCode). -->
      <section class="lp-hello">
        <div class="lp-container">
          <p class="lp-eyebrow" data-reveal>{t.hello.eyebrow}</p>
          <h2 class="lp-h2" data-reveal style="--rd:1">{t.hello.h2}</h2>
          <div class="lp-hello-grid">
            <div class="lp-hello-code" data-reveal>
              <Code code={helloCode} lang="ts" theme="css-variables" />
            </div>
            <div class="lp-hello-side" data-reveal-group style="--rd-base:1">
              <div class="lp-hello-visual" data-motion="img">
                <img
                  src={src("hello-result")}
                  alt={alt("hello-result")}
                  loading="lazy"
                  decoding="async"
                />
                <ImageAttribution
                  items={helloAttrib}
                  label={t.hello.mediaAttributionLabel}
                  corner="br"
                />
                <p class="lp-hello-cta">
                  <a href={localizeHref(links.gettingStarted)}
                    >{t.hello.cta}<ArrowUpRight class="lp-link-icon" size={15} /></a
                  >
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Architecture (light) -->
      <section class="lp-arch">
        <div class="lp-container">
          <p class="lp-eyebrow" data-reveal>{t.arch.eyebrow}</p>
          <h2 class="lp-h2" data-reveal style="--rd:1" set:html={t.arch.h2Html} />
          {/* The diagram is composed from the arch-* line-art SVGs rather than
              a baked image: source geometry (terrain / marker / buildings) on
              the left flows through converging arrows into the globe the
              renderer draws on the right. Pieces are decorative (alt=""); the
              node titles/subs carry the meaning. */}
          {/* Two grid rows: the titles sit in a shared head row and the visual
              bodies (source pieces / arrows / globe) in a body row of fixed
              height. Keeping the bodies in one aligned row is what lets the
              arrows converge on the globe's center regardless of how many lines
              each title wraps to. DOM order = the mobile (single-column) flow;
              desktop re-places the cells via grid-template-areas. */}
          <div
            class="lp-arch-flow"
            data-reveal
            style="--rd:3"
            role="img"
            aria-label={t.arch.diagramAlt}
          >
            <div class="lp-arch-head is-source">
              <h3 class="lp-arch-node-title">{t.arch.sourceTitle}</h3>
              <p class="lp-arch-node-sub">{t.arch.sourceSub}</p>
            </div>

            {/* Source pieces in equal-height slots so their centers land at
                1/6, 1/2, 5/6 of the body height — exactly the arrow origins. */}
            <div class="lp-arch-body is-source lp-arch-stack">
              <div class="lp-arch-slot">
                <img class="lp-arch-piece lp-arch-p-terrain" src={archTerrain} alt="" />
              </div>
              <div class="lp-arch-slot">
                <img class="lp-arch-piece lp-arch-p-marker" src={archMarker} alt="" />
              </div>
              <div class="lp-arch-slot">
                <img class="lp-arch-piece lp-arch-p-buildings" src={archBuildings} alt="" />
              </div>
            </div>

            {/* Converging arrows (arch-arrow.svg): points right on desktop;
                the same asset is rotated 90° to point down on mobile. */}
            <div class="lp-arch-body is-arrows lp-arch-arrows" aria-hidden="true">
              <img class="lp-arch-arrow-img" src={archArrow} alt="" />
            </div>

            <div class="lp-arch-head is-render">
              <h3 class="lp-arch-node-title">{t.arch.renderTitle}</h3>
              <p class="lp-arch-node-sub">{t.arch.renderSub}</p>
            </div>

            <div class="lp-arch-body is-render">
              {/* arch-globe.svg already contains the composited scene (terrain,
                  buildings, marker inside the globe) — nothing is overlaid. */}
              <div class="lp-arch-globe">
                <img class="lp-arch-globe-base" src={archGlobe} alt="" />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Gallery — Tutorial & Example -->
      <section class="lp-gallery">
        <div class="lp-gallery-strip">
          <!-- Section title overlays the first tile; a top scrim keeps it
               readable over any screenshot. -->
          <div class="lp-gallery-head" data-reveal-group>
            <p class="lp-eyebrow">{t.gallery.eyebrow}</p>
            <h2 class="lp-h2">{t.gallery.h2}</h2>
          </div>
          <aside class="lp-gallery-side">
            <div class="lp-gallery-side-inner">
              <div class="lp-gallery-side-set lp-set-active" data-gallery-set="tutorial">
                <p class="lp-gallery-label">{t.gallery.tutorial.label}</p>
                <p class="lp-gallery-link">
                  <a href={localizeHref(links.tutorial)}
                    >{t.gallery.tutorial.link}<ArrowUpRight class="lp-link-icon" size={15} /></a
                  >
                </p>
              </div>
              <div class="lp-gallery-side-set" data-gallery-set="example">
                <p class="lp-gallery-label">{t.gallery.example.label}</p>
                <p class="lp-gallery-link">
                  <a href={links.examples}
                    >{t.gallery.example.link}<ArrowUpRight class="lp-link-icon" size={15} /></a
                  >
                </p>
              </div>
            </div>
          </aside>
          <!-- On phones this wrapper scrolls horizontally so the grids keep
               their desktop composition; the label overlay stays outside the
               scroller, pinned to the viewport edge. -->
          <div class="lp-gallery-scroll">
          <div class="lp-tutorial-grid">
            <GalleryTile
              cellClass="lp-tile-wide"
              href={localizeHref(slot("tutorial-wide").href ?? links.tutorial)}
              imgSrc={src("tutorial-wide")}
              imgAlt={alt("tutorial-wide")}
              items={attrib("tutorial-wide")}
              label={galleryAttribLabel}
            />
            <GalleryTile
              cellClass="lp-tile-half"
              href={localizeHref(slot("tutorial-left").href ?? links.tutorial)}
              imgSrc={src("tutorial-left")}
              imgAlt={alt("tutorial-left")}
              items={attrib("tutorial-left")}
              label={galleryAttribLabel}
            />
            <GalleryTile
              cellClass="lp-tile-half"
              rd={1}
              href={localizeHref(slot("tutorial-right").href ?? links.tutorial)}
              imgSrc={src("tutorial-right")}
              imgAlt={alt("tutorial-right")}
              items={attrib("tutorial-right")}
              label={galleryAttribLabel}
            />
          </div>
          <div class="lp-example-grid">
          {/* Row 1 — 3:2 */}
          <GalleryTile
            cellClass="lp-span-36"
            href={slot("example-row1-left").href ?? links.examples}
            imgSrc={src("example-row1-left")}
            imgAlt={alt("example-row1-left")}
            items={attrib("example-row1-left")}
            label={galleryAttribLabel}
            logo={googleLogoSrc}
            logoAlt="Google Maps"
          />
          <GalleryTile
            cellClass="lp-span-24"
            rd={1}
            href={slot("example-row1-right").href ?? links.examples}
            imgSrc={src("example-row1-right")}
            imgAlt={alt("example-row1-right")}
            items={attrib("example-row1-right")}
            label={galleryAttribLabel}
          />
          {/* Row 2 — 1:1:1 */}
          <GalleryTile
            cellClass="lp-span-20"
            href={slot("example-row2-left").href ?? links.examples}
            imgSrc={src("example-row2-left")}
            imgAlt={alt("example-row2-left")}
            items={attrib("example-row2-left")}
            label={galleryAttribLabel}
          />
          <GalleryTile
            cellClass="lp-span-20"
            rd={1}
            href={slot("example-row2-center").href ?? links.examples}
            imgSrc={src("example-row2-center")}
            imgAlt={alt("example-row2-center")}
            items={attrib("example-row2-center")}
            label={galleryAttribLabel}
            logo={googleLogoSrc}
            logoAlt="Google Maps"
          />
          <GalleryTile
            cellClass="lp-span-20"
            rd={2}
            href={slot("example-row2-right").href ?? links.examples}
            imgSrc={src("example-row2-right")}
            imgAlt={alt("example-row2-right")}
            items={attrib("example-row2-right")}
            label={galleryAttribLabel}
          />
          {/* Row 3 — 2:3 */}
          <GalleryTile
            cellClass="lp-span-24"
            href={slot("example-row3-left").href ?? links.examples}
            imgSrc={src("example-row3-left")}
            imgAlt={alt("example-row3-left")}
            items={attrib("example-row3-left")}
            label={galleryAttribLabel}
          />
          <GalleryTile
            cellClass="lp-span-36"
            rd={1}
            href={slot("example-row3-right").href ?? links.examples}
            imgSrc={src("example-row3-right")}
            imgAlt={alt("example-row3-right")}
            items={attrib("example-row3-right")}
            label={galleryAttribLabel}
            logo={googleLogoSrc}
            logoAlt="Google Maps"
          />
          {/* Row 4 — 3:3:2:2 */}
          <GalleryTile
            cellClass="lp-span-15"
            href={slot("example-row4-left").href ?? links.examples}
            imgSrc={src("example-row4-left")}
            imgAlt={alt("example-row4-left")}
            items={attrib("example-row4-left")}
            label={galleryAttribLabel}
          />
          <GalleryTile
            cellClass="lp-span-15"
            rd={1}
            href={slot("example-row4-center-left").href ?? links.examples}
            imgSrc={src("example-row4-center-left")}
            imgAlt={alt("example-row4-center-left")}
            items={attrib("example-row4-center-left")}
            label={galleryAttribLabel}
          />
          <GalleryTile
            cellClass="lp-span-15"
            rd={2}
            href={slot("example-row4-center-right").href ?? links.examples}
            imgSrc={src("example-row4-center-right")}
            imgAlt={alt("example-row4-center-right")}
            items={attrib("example-row4-center-right")}
            label={galleryAttribLabel}
          />
          <GalleryTile
            cellClass="lp-span-15"
            rd={3}
            href={slot("example-row4-right").href ?? links.examples}
            imgSrc={src("example-row4-right")}
            imgAlt={alt("example-row4-right")}
            items={attrib("example-row4-right")}
            label={galleryAttribLabel}
          />
          </div>
          </div>
        </div>
      </section>

      <!-- MapLibre family (parked behind SHOW_MAPLIBRE for now) -->
      {SHOW_MAPLIBRE && (
      <section class="lp-maplibre">
        <div class="lp-container lp-maplibre-grid">
          <div data-reveal-group>
            <div class="lp-maplibre-brand">
              {
                src("maplibre-logo") ? (
                  <img
                    class="lp-maplibre-logo"
                    src={src("maplibre-logo")}
                    alt={alt("maplibre-logo")}
                  />
                ) : (
                  <div class="lp-maplibre-logo lp-maplibre-logo-placeholder" />
                )
              }
              <p class="lp-eyebrow lp-eyebrow-ml">{t.maplibre.eyebrow}</p>
            </div>
            <h2 class="lp-maplibre-h2">{t.maplibre.h2}</h2>
            <p class="lp-maplibre-copy">{t.maplibre.copy}</p>
            <ul class="lp-maplibre-list">
              {
                t.maplibre.items.map((item: string) => (
                  <li>
                    <Check class="lp-maplibre-check" size={16} aria-hidden="true" />
                    {item}
                  </li>
                ))
              }
            </ul>
            <p class="lp-maplibre-roadmap">
              <a href={localizeHref(links.roadmap)}
                >{t.maplibre.roadmap}<ArrowUpRight class="lp-link-icon" size={15} /></a
              >
            </p>
          </div>
          <div class="lp-maplibre-visual" data-reveal data-motion="img">
            {src("maplibre-visual") && <img src={src("maplibre-visual")} alt={alt("maplibre-visual")} />}
            <ImageAttribution
              items={maplibreAttrib}
              label={t.maplibre.mediaAttributionLabel}
              corner="bl"
            />
          </div>
        </div>
      </section>
      )}

      <!-- Closing call to action: the page opens dark and closes dark,
           flowing straight into the footer's matching band. -->
      <!-- The closing band: outro CTA and footer share one black canvas with
           the glow-globe still spanning both. -->
      <div class="lp-close">
        <img
          class="lp-outro-bg"
          src={src("outro-bg")}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
        <div class="lp-outro-scrim" aria-hidden="true" />
        <section class="lp-outro">
          <div class="lp-container lp-outro-content" data-reveal-group>
            <h2 class="lp-outro-h2">{t.outro.h2}</h2>
            <div class="lp-cta-row lp-outro-ctas">
              <a class="lp-btn-primary" href={localizeHref(links.gettingStarted)}>{t.outro.ctaPrimary}</a>
              <a class="lp-btn-outline" href={links.examples}>{t.outro.ctaSecondary}</a>
            </div>
          </div>
        </section>

        <!-- Get started (footer) -->
        <footer class="lp-footer" data-reveal-group>
          <div class="lp-footer-links">
            <a href={localizeHref(links.docs)}>{t.footer.docs}</a>
            <a href={links.github}>{t.footer.github}</a>
            <a href={links.discord}>{t.footer.discord}</a>
          </div>
          <p class="lp-footer-credit">{t.footer.credit}</p>
        </footer>
        <ImageAttribution
          items={outroAttrib}
          label={t.outro.mediaAttributionLabel}
          corner="tr"
        />
      </div>
      </div>
    </div>

    <script>
      // Navigate to the selected locale's landing page.
      document.querySelectorAll<HTMLSelectElement>("select[data-lp-lang]").forEach((el) => {
        el.addEventListener("change", () => {
          location.href = el.value;
        });
        // A native select drops its list on mousedown; suppress that and open
        // on the completed click instead (where showPicker is available —
        // otherwise the native behavior stays).
        if (typeof el.showPicker === "function") {
          el.addEventListener("mousedown", (e) => {
            e.preventDefault();
            el.focus();
          });
          el.addEventListener("click", () => el.showPicker());
        }
      });

      // Measure the catch-copy height so its sticky pin line sits exactly at
      // "fully revealed" (see .lp-intro's top calc).
      const stage = document.querySelector<HTMLElement>(".lp-hero-stage");
      const intro = document.querySelector<HTMLElement>(".lp-intro");
      if (stage && intro) {
        // Fractional height (not offsetHeight): a rounded value leaves a
        // sub-pixel hairline of hero video under the pinned panel.
        const setIntroHeight = () =>
          stage.style.setProperty("--lp-intro-h", `${intro.getBoundingClientRect().height}px`);
        setIntroHeight();
        window.addEventListener("resize", setIntroHeight);
        // Web fonts land after first paint and change the measured height,
        // which would leave a gap under the pinned panel — re-measure on any
        // reflow of the panel itself.
        new ResizeObserver(setIntroHeight).observe(intro);
      }

      // Scroll-linked fade for the catch-copy panel: it breathes in while it
      // rises over the hero, and once fully revealed it stays opaque — the
      // eased opacity rides the same scroll the slide does, so the two always
      // agree, and scrolling back up replays the fade in reverse.
      const heroPanel = document.querySelector<HTMLElement>(".lp-hero");
      if (
        stage &&
        intro &&
        heroPanel &&
        !matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        // Cubic ease-in: stays faint for most of the travel, then surges to
        // full opacity near the end.
        const easeIn = (t: number) => t * t * t;
        let fadeQueued = false;
        const applyIntroFade = () => {
          fadeQueued = false;
          const vh = window.innerHeight;
          const y = window.scrollY;
          // Reveal: the panel's top travels from the viewport bottom up to
          // its pin line — one panel-height of scroll. Past that it holds at
          // full opacity for the rest of the page.
          const revealStart = heroPanel.offsetHeight - vh;
          const revealSpan = intro.offsetHeight;
          const t = (y - revealStart) / revealSpan;
          intro.style.opacity = String(easeIn(Math.min(1, Math.max(0, t))));
        };
        const queueIntroFade = () => {
          if (!fadeQueued) {
            fadeQueued = true;
            requestAnimationFrame(applyIntroFade);
          }
        };
        applyIntroFade();
        window.addEventListener("scroll", queueIntroFade, { passive: true });
        window.addEventListener("resize", queueIntroFade);
      }

      // The scroll cue has served its purpose once scrolling starts — fade it
      // out for good.
      const scrollCue = document.querySelector<HTMLElement>(".lp-hero-scroll-cue");
      if (scrollCue) {
        const dismissCue = () => {
          if (window.scrollY > 24) {
            scrollCue.classList.add("lp-cue-done");
            window.removeEventListener("scroll", dismissCue);
          }
        };
        window.addEventListener("scroll", dismissCue, { passive: true });
      }

      // The full-screen bands subtract the fixed header's height; publish the
      // real height (it varies with the breakpoint) so the last band ends
      // flush with the header when scrolled to the bottom.
      const headerEl = document.querySelector<HTMLElement>(".lp-header");
      if (headerEl) {
        const setHeaderHeight = () =>
          document.documentElement.style.setProperty(
            "--lp-header-h",
            `${headerEl.getBoundingClientRect().height}px`,
          );
        setHeaderHeight();
        new ResizeObserver(setHeaderHeight).observe(headerEl);
      }

      // Give the fixed header a dark backdrop once the hero has scrolled away.
      const header = document.querySelector(".lp-header");
      const hero = document.querySelector(".lp-hero");
      if (header && hero) {
        const headerObserver = new IntersectionObserver(([entry]) => {
          header.classList.toggle("lp-header-solid", !entry.isIntersecting);
        });
        headerObserver.observe(hero);
      }

      // Crossfade the gallery overlay label when it crosses into the example
      // grid (and back, when scrolling up).
      const exampleGrid = document.querySelector(".lp-example-grid");
      const gallerySets = document.querySelectorAll<HTMLElement>(".lp-gallery-side-set");
      if (exampleGrid && gallerySets.length) {
        const galleryObserver = new IntersectionObserver(
          ([entry]) => {
            const active = entry.isIntersecting ? "example" : "tutorial";
            gallerySets.forEach((set) => {
              set.classList.toggle("lp-set-active", set.dataset.gallerySet === active);
            });
          },
          // Shrink the viewport bottom to roughly the overlay label position,
          // so the swap happens as the label meets the example images.
          { rootMargin: "0px 0px -140px 0px" },
        );
        galleryObserver.observe(exampleGrid);
      }

      // Adaptive gallery label ink: sample the luminance of the tile image
      // behind the sticky label and switch between white and the theme ink,
      // picking whichever has the higher WCAG contrast. This also covers
      // mid-gray backdrops, where neither pure inversion nor a fixed color
      // works well — the better of the two candidates always wins.
      const gallerySide = document.querySelector<HTMLElement>(".lp-gallery-side");
      const gallerySideInner = document.querySelector<HTMLElement>(".lp-gallery-side-inner");
      if (gallerySide && gallerySideInner) {
        // Linearize an sRGB channel (0-255) for relative-luminance math.
        const linear = (c: number): number => {
          const s = c / 255;
          return s <= 0.04045 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
        };
        const contrast = (a: number, b: number): number =>
          (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
        // Luminance of the theme ink (--pri, always #rrggbb from lp.json).
        const priHex = getComputedStyle(document.documentElement)
          .getPropertyValue("--pri")
          .trim();
        const priLum =
          0.2126 * linear(parseInt(priHex.slice(1, 3), 16)) +
          0.7152 * linear(parseInt(priHex.slice(3, 5), 16)) +
          0.0722 * linear(parseInt(priHex.slice(5, 7), 16));

        // Average luminance of the left quarter of the image's VISIBLE crop —
        // tiles render with object-fit: cover, so the displayed region must be
        // derived from the tile's aspect ratio before sampling. Sampled once
        // per image on a small canvas.
        const lumCache = new WeakMap<HTMLImageElement, number>();
        const luminanceOf = (img: HTMLImageElement): number | null => {
          const cached = lumCache.get(img);
          if (cached !== undefined) return cached;
          if (!img.complete || !img.naturalWidth) return null;
          const canvas = document.createElement("canvas");
          canvas.width = 12;
          canvas.height = 24;
          const ctx = canvas.getContext("2d", { willReadFrequently: true });
          if (!ctx) return null;
          // Source rect actually shown by object-fit: cover (centered crop).
          const scale = Math.max(
            img.clientWidth / img.naturalWidth,
            img.clientHeight / img.naturalHeight,
          );
          const visW = img.clientWidth / scale || img.naturalWidth;
          const visH = img.clientHeight / scale || img.naturalHeight;
          const sx = (img.naturalWidth - visW) / 2;
          const sy = (img.naturalHeight - visH) / 2;
          ctx.drawImage(img, sx, sy, visW / 4, visH, 0, 0, 12, 24);
          const data = ctx.getImageData(0, 0, 12, 24).data;
          let sum = 0;
          for (let i = 0; i < data.length; i += 4) {
            sum +=
              0.2126 * linear(data[i]) +
              0.7152 * linear(data[i + 1]) +
              0.0722 * linear(data[i + 2]);
          }
          const lum = sum / (data.length / 4);
          lumCache.set(img, lum);
          return lum;
        };

        // Per-tile attribution ink: sample the image pixels DIRECTLY UNDER the
        // info icon (top-right) and flip it to dark ink over light spots,
        // keeping white over dark — whichever contrasts better. Geometry is
        // measured relative to the cell (its reveal transform is a translate,
        // which cancels in the difference) and mapped through object-fit: cover.
        const lumUnder = (
          img: HTMLImageElement,
          cell: Element,
          el: Element,
        ): number | null => {
          if (!img.complete || !img.naturalWidth) return null;
          const cr = cell.getBoundingClientRect();
          const er = el.getBoundingClientRect();
          const cw = img.clientWidth || cr.width;
          const ch = img.clientHeight || cr.height;
          if (!cw || !ch) return null;
          const scale = Math.max(cw / img.naturalWidth, ch / img.naturalHeight);
          const visW = cw / scale;
          const visH = ch / scale;
          const cropX = (img.naturalWidth - visW) / 2;
          const cropY = (img.naturalHeight - visH) / 2;
          let sx = cropX + (er.left - cr.left) / scale;
          let sy = cropY + (er.top - cr.top) / scale;
          let sw = er.width / scale;
          let sh = er.height / scale;
          sx = Math.max(0, Math.min(sx, img.naturalWidth - 1));
          sy = Math.max(0, Math.min(sy, img.naturalHeight - 1));
          sw = Math.max(1, Math.min(sw, img.naturalWidth - sx));
          sh = Math.max(1, Math.min(sh, img.naturalHeight - sy));
          const canvas = document.createElement("canvas");
          canvas.width = 8;
          canvas.height = 8;
          const ctx = canvas.getContext("2d", { willReadFrequently: true });
          if (!ctx) return null;
          try {
            ctx.drawImage(img, sx, sy, sw, sh, 0, 0, 8, 8);
            const data = ctx.getImageData(0, 0, 8, 8).data;
            let sum = 0;
            for (let i = 0; i < data.length; i += 4) {
              sum +=
                0.2126 * linear(data[i]) +
                0.7152 * linear(data[i + 1]) +
                0.0722 * linear(data[i + 2]);
            }
            return sum / (data.length / 4);
          } catch {
            return null; // tainted canvas (cross-origin) — leave the default ink
          }
        };
        const sampleInk = (cell: Element) => {
          const img = cell.querySelector("img");
          const attr = cell.querySelector(".nv-attrib");
          const btn = cell.querySelector(".nv-attrib-btn");
          if (!img || !attr || !btn) return;
          const lum = lumUnder(img as HTMLImageElement, cell, btn);
          if (lum === null) return;
          attr.classList.toggle(
            "nv-attrib-ink-dark",
            contrast(priLum, lum) > contrast(1, lum),
          );
        };
        // Sample when a tile is (near) on screen: by then its layout — and thus
        // the info button's position, which the sampled rect depends on — has
        // settled, avoiding an early read of stale geometry.
        const inkObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              const cell = e.target;
              const img = cell.querySelector("img") as HTMLImageElement | null;
              if (img && (!img.complete || !img.naturalWidth)) {
                img.addEventListener("load", () => sampleInk(cell), { once: true });
              } else {
                sampleInk(cell);
              }
              inkObserver.unobserve(cell);
            });
          },
          { rootMargin: "300px" },
        );
        const inkCells = document.querySelectorAll(".lp-tile-cell");
        inkCells.forEach((cell) => inkObserver.observe(cell));
        // The cover crop (and thus the sampled pixels) shifts with tile size.
        let inkResizeTimer = 0;
        window.addEventListener("resize", () => {
          clearTimeout(inkResizeTimer);
          inkResizeTimer = window.setTimeout(
            () => inkCells.forEach((cell) => sampleInk(cell)),
            150,
          );
        });

        let sideTicking = false;
        const updateSideInk = () => {
          sideTicking = false;
          const rect = gallerySideInner.getBoundingClientRect();
          if (rect.bottom < 0 || rect.top > window.innerHeight) return;
          const x = Math.max(1, Math.min(rect.left + rect.width / 2, window.innerWidth - 1));
          const y = Math.max(1, Math.min(rect.top + rect.height * 0.55, window.innerHeight - 1));
          const tile = document
            .elementsFromPoint(x, y)
            .find((el) => el.closest(".lp-tile"))
            ?.closest(".lp-tile");
          const img = tile?.querySelector("img");
          if (!img) return;
          const bg = luminanceOf(img);
          if (bg === null) return;
          gallerySide.classList.toggle("lp-side-dark", contrast(priLum, bg) > contrast(1, bg));
        };
        const requestSideInk = () => {
          if (!sideTicking) {
            sideTicking = true;
            requestAnimationFrame(updateSideInk);
          }
        };
        window.addEventListener("scroll", requestSideInk, { passive: true });
        window.addEventListener("resize", requestSideInk);
        // The phone gallery scrolls horizontally inside its own container.
        document
          .querySelector(".lp-gallery-scroll")
          ?.addEventListener("scroll", requestSideInk, { passive: true });
        requestSideInk();
      }

      // Gallery tiles: open in a new tab, and reveal the example/tutorial name
      // (reused from the image alt) at the bottom-right on hover.
      document.querySelectorAll<HTMLAnchorElement>("a.lp-tile").forEach((tile) => {
        tile.target = "_blank";
        tile.rel = "noopener noreferrer";
        const img = tile.querySelector("img");
        if (!img || !img.alt) return;
        const label = document.createElement("span");
        label.className = "lp-tile-title";
        label.textContent = img.alt;
        tile.appendChild(label);
      });

      // Resolves once every <img> inside the element is loaded and decoded
      // (errors resolve too, so a broken image can never block an entrance).
      // Elements without images resolve immediately.
      const imagesReady = (el: Element): Promise<unknown> =>
        Promise.all(
          Array.from(el.querySelectorAll("img"), (img) => img.decode().catch(() => {})),
        );

      // Longest entrance: max stagger delay (0.75s) + slowest transition
      // (2.8s photo settle), rounded up. will-change promotion is released
      // after this so entrances never compete with each other for layers.
      const REVEAL_MS = 4000;

      // Promote everything an entrance animates onto its own compositor
      // layer for the duration of the transition, so a busy main thread
      // (image decode, layout) cannot freeze it mid-flight. The promotion
      // is temporary: keeping dozens of full-bleed layers alive would cost
      // more than it saves.
      const playReveal = (el: Element): void => {
        const layered = [el, ...el.children, ...el.querySelectorAll("img")] as HTMLElement[];
        layered.forEach((t) => (t.style.willChange = "opacity, transform"));
        // Two frames so the promotion is committed before the transition starts.
        requestAnimationFrame(() =>
          requestAnimationFrame(() => el.classList.add("lp-revealed")),
        );
        setTimeout(() => layered.forEach((t) => (t.style.willChange = "")), REVEAL_MS);
      };

      // Reveal-on-scroll: elements marked data-reveal (observed individually)
      // and data-reveal-group containers (which gate their staggered children)
      // play their entrance once they cross the lower edge of the viewport and
      // every image inside them is ready, so nothing fades in half-rendered.
      // Hidden states only exist under prefers-reduced-motion: no-preference,
      // so for reduced motion the class toggle is a no-op.
      const revealEls = document.querySelectorAll("[data-reveal], [data-reveal-group]");
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              const el = entry.target;
              imagesReady(el).then(() => playReveal(el));
              revealObserver.unobserve(el);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px" },
      );
      revealEls.forEach((el) => revealObserver.observe(el));

      // Decode every landing-page image during idle time right after load, so
      // large decodes are spread out instead of bursting exactly when a
      // reveal (or a running entrance nearby) needs the main thread.
      const predecode = () =>
        document
          .querySelectorAll<HTMLImageElement>(".lp img")
          .forEach((img) => img.decode().catch(() => {}));
      "requestIdleCallback" in window
        ? requestIdleCallback(predecode, { timeout: 2000 })
        : setTimeout(predecode, 300);

      // API tier showcase: cross-fade the still through one scene per tier
      // and light the matching caption + ring label in sync. It auto-advances
      // while on screen (never under reduced motion); clicking a ring label
      // jumps to its tier and restarts the hold from there.
      const apiStage = document.querySelector<HTMLElement>(".lp-api-stage");
      if (apiStage) {
        const stills = Array.from(
          apiStage.querySelectorAll<HTMLElement>(".lp-api-media img"),
        );
        const caps = Array.from(
          apiStage.querySelectorAll<HTMLElement>(".lp-api-cap"),
        );
        const nodes = Array.from(
          apiStage.querySelectorAll<HTMLElement>(".lp-api-node"),
        );
        const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
        const TIER_HOLD_MS = 3600;
        let tier = 0;
        let tierTimer: number | undefined;
        const showTier = (i: number) => {
          tier = i;
          stills.forEach((img, j) => img.classList.toggle("lp-tier-visible", j === i));
          caps.forEach((cap, j) => cap.classList.toggle("lp-tier-active", j === i));
          nodes.forEach((node) =>
            node.classList.toggle("lp-tier-active", Number(node.dataset.tier) === i),
          );
        };
        const stopTiers = () => {
          if (tierTimer !== undefined) {
            clearInterval(tierTimer);
            tierTimer = undefined;
          }
        };
        const startTiers = () => {
          if (tierTimer === undefined && !reducedMotion.matches) {
            tierTimer = window.setInterval(
              () => showTier((tier + 1) % stills.length),
              TIER_HOLD_MS,
            );
          }
        };
        new IntersectionObserver(
          ([entry]) => (entry.isIntersecting ? startTiers() : stopTiers()),
          { threshold: 0.35 },
        ).observe(apiStage);
        nodes.forEach((node) =>
          node.addEventListener("click", () => {
            showTier(Number(node.dataset.tier));
            stopTiers();
            startTiers();
          }),
        );
      }

      // Hero video: pick the phone or desktop encode, fade the (identical)
      // first frame in over the poster still, and only start the infinite
      // loop once that fade has finished — motion never happens on a
      // semi-transparent video ghosting against the static poster. Reduced
      // motion keeps the still.
      const heroEl = document.querySelector<HTMLElement>(".lp-hero");
      const heroVideo = document.querySelector<HTMLVideoElement>(".lp-hero-video");
      if (heroEl && heroVideo) {
        if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
          const sp = window.matchMedia("(max-width: 640px)").matches;
          // Not `once`: the blocked state can come back (e.g. the resume
          // after fullscreen is refused in Low Power Mode), so every
          // successful (re)start must clear it again.
          heroVideo.addEventListener("playing", () => {
            heroEl.classList.add("lp-video-live");
            heroEl.classList.remove("lp-video-blocked");
          });
          heroVideo.addEventListener(
            "loadeddata",
            () => {
              // First frame is decodable: fade it in (still paused), then
              // start playback when the opacity transition ends. Autoplay can
              // be refused (iOS Low Power Mode, browser policies); that
              // cannot be overridden, but a play() from a tap is still
              // allowed, so surface a play button as the fallback.
              heroEl.classList.add("lp-video-live");
              let started = false;
              const start = () => {
                if (started) return;
                started = true;
                heroVideo.play().catch(() => heroEl.classList.add("lp-video-blocked"));
              };
              heroVideo.addEventListener("transitionend", start, { once: true });
              // Fallback in case transitionend never fires (display: none
              // ancestors, interrupted transitions).
              window.setTimeout(start, 1200);
            },
            { once: true },
          );
          heroVideo.src = (sp ? heroVideo.dataset.srcSp : heroVideo.dataset.src) ?? "";
          const playButton = document.querySelector<HTMLButtonElement>(".lp-hero-play");
          playButton?.addEventListener("click", () => heroVideo.play().catch(() => {}));
        }
        const fsButton = document.querySelector<HTMLButtonElement>(".lp-hero-fs");
        fsButton?.addEventListener("click", () => {
          // iOS Safari only offers the vendor call, and only on the element.
          const v = heroVideo as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
          if (v.requestFullscreen) v.requestFullscreen().catch(() => {});
          else v.webkitEnterFullscreen?.();
        });
        // Leaving fullscreen pauses the video (iOS closes its native player
        // with a pause). Resuming right away races the player teardown —
        // WebKit can pause again AFTER our play() succeeded, which leaves the
        // video stopped without any rejection to react to. So: resume after a
        // beat, then verify playback actually stuck; if it did not (teardown
        // race, Low Power Mode refusal), surface the play button.
        const inNativeFullscreen = () => {
          const v = heroVideo as HTMLVideoElement & { webkitDisplayingFullscreen?: boolean };
          return Boolean(document.fullscreenElement) || Boolean(v.webkitDisplayingFullscreen);
        };
        const resume = () => {
          window.setTimeout(() => {
            if (heroVideo.paused && !inNativeFullscreen()) {
              heroVideo.play().catch(() => {});
            }
          }, 500);
          window.setTimeout(() => {
            if (heroVideo.paused && !inNativeFullscreen()) {
              heroEl.classList.add("lp-video-blocked");
            }
          }, 1000);
        };
        heroVideo.addEventListener("webkitendfullscreen", resume);
        document.addEventListener("fullscreenchange", () => {
          if (!document.fullscreenElement) resume();
        });
        // Catch-all: if the loop stops for any other reason while the page is
        // visible (tab restore, media-session interference), offer the button.
        heroVideo.addEventListener("pause", () => {
          window.setTimeout(() => {
            if (
              heroVideo.paused &&
              !inNativeFullscreen() &&
              document.visibilityState === "visible"
            ) {
              heroEl.classList.add("lp-video-blocked");
            }
          }, 1000);
        });
        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState === "visible" && heroVideo.paused) resume();
        });
      }

      // The hero opening also waits for its image, fading it in only once it
      // can be painted in full.
      const heroImg = document.querySelector<HTMLImageElement>(".lp-hero img");
      if (heroImg) {
        heroImg
          .decode()
          .catch(() => {})
          .then(() => {
            heroImg.style.willChange = "opacity, transform";
            heroImg.classList.add("lp-loaded");
            heroImg.addEventListener(
              "animationend",
              () => (heroImg.style.willChange = ""),
              { once: true },
            );
          });
      }
    </script>
    <noscript>
      <style>
        [data-reveal],
        [data-reveal-group] > * {
          opacity: 1 !important;
          transform: none !important;
        }
        [data-motion="img"] img {
          transform: none !important;
        }
        .lp-hero img {
          opacity: 1 !important;
        }
      </style>
    </noscript>

    <style is:global>
      :root {
        --ink: color-mix(in oklab, var(--pri), black 20%);
        --ink-soft: color-mix(in oklab, var(--pri), white 35%);
        --on-dark: color-mix(in oklab, var(--pri), white 88%);
        --on-dark-soft: color-mix(in oklab, var(--pri), white 60%);
        --line: color-mix(in oklab, var(--pri), white 85%);
        --line-dark: color-mix(in oklab, var(--pri), white 14%);
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: var(--sub);
        color: var(--ink);
        font-family: "Arsenal", "Zen Kaku Gothic New", sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .lp a {
        color: color-mix(in oklab, var(--acc), black 25%);
        text-decoration: none;
      }
      .lp a:hover {
        color: var(--acc);
      }
      /* Attribution credit links keep an underline — override the
         accent-coloured, underline-less default LP link style above. */
      .lp .nv-attrib-list a,
      .lp .nv-attrib-list a:hover {
        color: var(--on-dark);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      /* Attribution icons follow the LP's on-dark ink (the per-tile
         luminance flip to theme ink stays, its selector is more specific). */
      .lp .nv-attrib-btn {
        color: var(--on-dark);
      }
      /* Zero-specificity reset so per-section margin rules always win. */
      :where(.lp h1, .lp h2, .lp h3, .lp p) {
        margin: 0;
      }
      .lp img {
        display: block;
      }
      .lp-container {
        max-width: 1320px;
        margin: 0 auto;
      }

      /* Motion system — scroll-driven reveals.
         data-reveal: observed individually; data-reveal-group: the container
         is observed and its direct children stagger in DOM order. --rd is the
         stagger step (x 90ms), --rd-base shifts a whole group; both can be
         overridden inline for custom orders (e.g. the architecture diagram).
         data-motion variants: "img" = photo settle (frame fades, image scales
         down into place), "grow" = connectors growing upward. Everything is
         disabled under prefers-reduced-motion and, via <noscript>, without JS. */
      @media (prefers-reduced-motion: no-preference) {
        /* Page-load opening: the hero settles in, then the header drops in.
           The hero hides until JS marks its image as loaded (lp-loaded), so
           the fade always plays over the finished picture. The keyframes spell
           out the "to" state because the base state here is the hidden one. */
        @keyframes nv-hero-in {
          from {
            opacity: 0;
            transform: scale(1.045);
          }
          to {
            opacity: 1;
            transform: none;
          }
        }
        .lp-hero img {
          opacity: 0;
        }
        .lp-hero img.lp-loaded {
          animation: nv-hero-in 3s cubic-bezier(0.3, 0.5, 0.2, 1) both;
        }
        @keyframes nv-header-in {
          from {
            opacity: 0;
            transform: translateY(-10px);
          }
        }
        .lp-header {
          animation: nv-header-in 1.6s 0.8s cubic-bezier(0.3, 0.5, 0.2, 1) both;
        }

        [data-reveal],
        [data-reveal-group] > * {
          opacity: 0;
          transform: translateY(22px);
          /* Soft, airy feel: a long fade on a gentle ease-out, with an even
             longer drift so elements seem to breathe into place. */
          transition:
            opacity 1.4s cubic-bezier(0.3, 0.5, 0.2, 1),
            transform 1.8s cubic-bezier(0.3, 0.5, 0.2, 1);
          transition-delay: calc((var(--rd-base, 0) + var(--rd, 0)) * 150ms);
        }
        /* DOM-order stagger inside groups. :nth-child(1) is explicit so a
           nested group's first child does not inherit its parent's --rd. */
        [data-reveal-group] > :nth-child(1) {
          --rd: 0;
        }
        [data-reveal-group] > :nth-child(2) {
          --rd: 1;
        }
        [data-reveal-group] > :nth-child(3) {
          --rd: 2;
        }
        [data-reveal-group] > :nth-child(4) {
          --rd: 3;
        }
        [data-reveal-group] > :nth-child(5) {
          --rd: 4;
        }
        [data-reveal-group] > :nth-child(6) {
          --rd: 5;
        }
        /* Photo settle: the frame only fades while the image scales down into
           place (tiles clip the overshoot via overflow: hidden). */
        [data-motion="img"] {
          transform: none;
        }
        .lp [data-motion="img"] img {
          transform: scale(1.05);
          transition:
            transform 2.8s cubic-bezier(0.3, 0.5, 0.2, 1),
            filter 0.35s ease;
          transition-delay: calc((var(--rd-base, 0) + var(--rd, 0)) * 150ms), 0s;
        }
        /* Connectors grow upward, matching the core-first build order. */
        [data-motion="grow"] {
          transform: scaleY(0);
          transform-origin: bottom;
        }
        /* Revealed states last, so they win the equal-specificity ties. */
        [data-reveal].lp-revealed,
        .lp-revealed[data-reveal-group] > * {
          opacity: 1;
          transform: none;
        }
        .lp-revealed[data-motion="img"] img,
        .lp-revealed[data-reveal-group] > [data-motion="img"] img {
          transform: none;
        }
      }

      /* Header: always fixed; gains a dark backdrop once the hero is gone
         so the light sections keep it readable. */
      .lp-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 48px;
        transition: background 0.3s ease;
      }
      .lp-header.lp-header-solid {
        background: color-mix(in srgb, var(--pri) 88%, transparent);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
      }
      .lp-wordmark {
        font: 700 22px "Arsenal", "Zen Kaku Gothic New", sans-serif;
        letter-spacing: 0.04em;
        color: var(--on-dark);
      }
      .lp-nav {
        display: flex;
        align-items: center;
        gap: 28px;
