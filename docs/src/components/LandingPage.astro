      }
      .lp-nav-github svg {
        display: block;
        width: 20px;
        height: 20px;
      }
      .lp-nav-github svg path {
        fill: currentColor;
      }
      .lp-lang {
        position: relative;
        display: flex;
        align-items: center;
        gap: 7px;
        color: var(--on-dark);
        cursor: pointer;
      }
      .lp-lang:hover {
        color: var(--acc);
      }
      .lp-lang svg {
        display: block;
        flex: none;
      }
      .lp-lang-label {
        /* Tall enough that Latin descenders are not clipped. */
        font: 500 13px/18px "Arsenal", "Zen Kaku Gothic New", sans-serif;
        padding-right: 16px;
      }
      /* The select is an invisible hit area over the whole switcher — the
         visible text is the span; only the native dropdown list shows. */
      .lp-lang select {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        appearance: none;
        border: none;
        opacity: 0;
        cursor: pointer;
      }
      /* Draw the focus ring around the whole switcher (icon + label + arrow). */
      .lp-lang select:focus-visible {
        outline: none;
      }
      .lp-lang:has(select:focus-visible) {
        outline: 1px solid var(--acc);
        outline-offset: 5px;
        border-radius: 2px;
      }
      /* Native dropdown list opens on a light background. */
      .lp-lang select option {
        color: var(--pri);
      }
      .lp-lang .lp-lang-chevron {
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
      }
      /* Inline arrow icons sit on the text baseline row of their link. */
      .lp .lp-getting-started a,
      .lp .lp-gallery-link a,
      .lp .lp-maplibre-roadmap a {
        display: inline-flex;
        align-items: center;
        gap: 3px;
      }
      .lp-link-icon {
        flex: none;
        /* Arsenal / Zen Kaku glyphs sit low in the em box; drop the icon to
           its optical center. */
        transform: translateY(1.5px);
      }
      /* Hero */
      .lp-hero-stage {
        position: relative;
      }
      /* Invisible scroll budget: while it is consumed, the hero and the
         fully revealed catch copy stay pinned, so the page appears to pause.
         Never shown as blank space — the pinned hero covers the viewport. */
      .lp-hero-stage::after {
        content: "";
        display: block;
        height: 40vh;
      }
      .lp-hero {
        /* Fill the first screen and stay pinned while the catch copy slides
           over it; the sticky range is bounded by .lp-hero-stage, so normal
           scrolling resumes once the catch copy is fully visible. */
        position: sticky;
        top: 0;
        /* svh keeps the pinned hero stable under mobile dynamic toolbars. */
        height: 100vh;
        height: 100svh;
        min-height: 480px;
        background: var(--pri);
      }
      .lp-hero img,
      .lp-hero video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        /* Center crop: on phones the 16:9 frame is cut down to the portrait
           viewport around its middle (the fullscreen button shows it all). */
        object-fit: cover;
        object-position: center;
      }
      /* The video sits over the poster still and only fades in once playback
         has actually started, so the poster covers loading and autoplay
         refusals alike. */
      .lp-hero video {
        opacity: 0;
        transition: opacity 0.9s ease;
      }
      .lp-hero.lp-video-live video {
        opacity: 1;
      }
      .lp-hero-fs {
        display: none;
        position: absolute;
        right: 16px;
        bottom: 20px;
        z-index: 2;
        width: 44px;
        height: 44px;
        align-items: center;
        justify-content: center;
        border: 1px solid color-mix(in srgb, #fff 35%, transparent);
        border-radius: 50%;
        background: color-mix(in srgb, var(--pri) 45%, transparent);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: var(--on-dark);
        cursor: pointer;
      }
      @media (max-width: 640px) {
        .lp-hero-fs {
          display: flex;
        }
      }
      /* Autoplay-refused fallback (iOS Low Power Mode etc.): a centered play
         button; a tap-initiated play() is allowed even when autoplay is not. */
      .lp-hero-play {
        display: none;
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        z-index: 2;
        width: 64px;
        height: 64px;
        align-items: center;
        justify-content: center;
        border: 1px solid color-mix(in srgb, #fff 35%, transparent);
        border-radius: 50%;
        background: color-mix(in srgb, var(--pri) 45%, transparent);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: var(--on-dark);
        cursor: pointer;
      }
      .lp-hero.lp-video-blocked .lp-hero-play {
        display: flex;
      }
      /* Phone-only scroll cue at the bottom center of the hero video. */
      .lp-hero-scroll-cue {
        display: none;
        position: absolute;
        left: 50%;
        bottom: 22px;
        transform: translateX(-50%);
        z-index: 2;
