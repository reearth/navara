      /* full-bleed band: break out of the container to the viewport edges,
         capped to roughly the window height so it never runs too tall */
      .lp-api-media {
        position: relative;
        aspect-ratio: 16 / 9;
        max-height: 95vh;
        overflow: hidden;
        background: color-mix(in oklab, var(--pri), white 90%);
        width: 100vw;
        margin-left: calc(50% - 50vw);
        border-radius: 0;
      }
      .lp-api-media img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        /* bias the cover-crop toward the top so more sky shows */
        object-position: center 28%;
        opacity: 0;
        transition: opacity 0.9s ease;
      }
      .lp-api-media img.lp-tier-visible {
        opacity: 1;
      }
      /* keep the still readable under the thin white ring + captions */
      .lp-api-scrim {
        position: absolute;
        inset: 0;
        z-index: 1;
        background:
          radial-gradient(
            circle at 88% 84%,
            color-mix(in srgb, var(--pri) 60%, transparent),
            color-mix(in srgb, var(--pri) 30%, transparent) 40%,
            color-mix(in srgb, var(--pri) 10%, transparent) 70%
          ),
          linear-gradient(to top, color-mix(in srgb, var(--pri) 62%, transparent), transparent 34%);
      }
      /* attribution: no background, white icon with a shadow, tucked into
         the top-right corner */
      .lp-api-media .nv-attrib-tr {
        top: clamp(12px, 1.6vw, 24px);
        right: clamp(12px, 1.6vw, 24px);
      }
      .lp-api-media .nv-attrib-btn,
      .lp-api-media .nv-attrib-btn:hover {
        padding: 2px;
        background: none;
        color: var(--on-dark);
        box-shadow: none;
        backdrop-filter: none;
        filter: drop-shadow(0 1px 5px rgba(0, 0, 0, 0.65));
      }
      .lp-api-media .nv-attrib-btn svg {
        width: 19px;
        height: 19px;
      }

      /* per-tier caption, overlaid bottom-left; stacked so swaps never shift */
      .lp-api-caps {
        position: absolute;
        z-index: 2;
        left: 0;
        bottom: 0;
        max-width: 680px;
        padding: 0 clamp(28px, 5vw, 100px) 40px;
        display: grid;
      }
      .lp-api-cap {
        grid-area: 1 / 1;
        opacity: 0;
        transform: translateY(6px);
        transition:
          opacity 0.6s ease,
          transform 0.6s ease;
      }
      .lp-api-cap.lp-tier-active {
        opacity: 1;
        transform: none;
      }
      .lp-api-cap-title {
        margin: 0;
        color: var(--on-dark);
        font-size: 23px;
        font-weight: 660;
        letter-spacing: 0.02em;
      }
      .lp-api-cap-scene {
        font-size: 14px;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.58);
        margin-left: 12px;
        letter-spacing: 0;
      }
      .lp-api-cap-desc {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.9);
        font-size: 16.5px;
        line-height: 1.6;
      }
      /* editorial open ring, bottom-right; geometry authored at 240px */
      .lp-api-ring {
        position: absolute;
        z-index: 3;
        /* the drawn circle sits ~27px inside the wrap (24px * scale), so
           subtract that so its right/bottom gap matches the left text margin
           (horizontal clamp(28,5vw,100) and the caption's 40px bottom) */
        right: calc(clamp(28px, 5vw, 100px) - 32px);
        bottom: 8px;
        width: 240px;
        height: 240px;
        transform: scale(1.32);
        transform-origin: bottom right;
      }
      .lp-api-ring svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
      }
      /* larger ring, but kept quiet: a thinner, dimmer track so the bigger
         size reads as spacious rather than loud */
      .lp-api-track {
        fill: none;
        stroke: rgba(255, 255, 255, 0.42);
        stroke-width: 1.1;
        stroke-linecap: round;
      }
      .lp-api-node {
        position: absolute;
        z-index: 4;
        border: 0;
        background: none;
        padding: 6px 8px;
        cursor: pointer;
        font: inherit;
        white-space: nowrap;
      }
      .lp-api-node span {
        display: block;
        font-size: 16px;
        font-weight: 560;
        color: rgba(255, 255, 255, 0.6);
        transition:
          color 0.3s ease,
          text-shadow 0.5s ease;
      }
      /* hover cue so it reads as clickable (pointer devices only) */
      @media (hover: hover) {
        .lp-api-node:hover span {
          color: var(--on-dark);
        }
      }
      /* The active label keeps its accent glow — a design element, not a
         readability shadow. */
      .lp-api-node.lp-tier-active span {
        color: var(--on-dark);
        font-weight: 640;
        text-shadow:
          0 0 7px var(--acc),
          0 0 16px var(--acc),
          0 0 30px color-mix(in oklab, var(--acc), transparent 35%),
          0 0 48px color-mix(in oklab, var(--acc), transparent 60%);
      }
      .lp-api-node:focus-visible {
        outline: 2px solid var(--acc);
        outline-offset: 2px;
        border-radius: 6px;
      }
      .lp-node-dec {
        left: 120px;
        top: 120px;
        transform: translate(-50%, -50%);
        z-index: 5;
      }
      .lp-node-plugin {
        left: 120px;
        top: 24px;
        transform: translate(-50%, -50%);
      }
      .lp-node-api {
        left: 193.5px;
        top: 181.7px;
        transform: translate(-50%, -50%);
      }
      .lp-node-shader {
        left: 46.5px;
        top: 181.7px;
        transform: translate(-50%, -50%);
      }

      /* Architecture (light, between the tinted "why" band and the black
         gallery) */
      /* Hello world: the whole first program beside its rendered result, on
         a dark band echoing the hero. */
      .lp-hello {
        /* One screen tall (minus the 68px fixed header): real height with
           the content self-centering, not padding. */
        display: flex;
        flex-direction: column;
        justify-content: center;
        box-sizing: border-box;
        min-height: calc(100svh - var(--lp-header-h, 68px));
        padding: 96px 48px;
        background: var(--pri);
        color: var(--on-dark);
      }
      .lp-hello .lp-eyebrow {
        color: var(--acc);
      }
      /* The code card drives the row height; the visual fills the remaining
         height of the side column (copy + CTA keep their natural size), so
         the image bottom lines up with the code card no matter how long the
         snippet is. */
      .lp-hello-grid {
        display: grid;
        grid-template-columns: minmax(0, 9fr) minmax(0, 11fr);
        gap: 56px;
        align-items: stretch;
        margin-top: 44px;
      }
      .lp-hello-side {
        display: flex;
        flex-direction: column;
      }
      /* The code card is the section's visual anchor: the hero's dark ink as
         a panel, with the Shiki css-variables theme mapped onto the LP
         palette so a theme change in lp.json restyles the code too. */
      .lp-hello-code {
        border-radius: 14px;
        /* A step lighter than the section band, with a hairline, so the card
           still reads as a panel on the same-ink background. */
        background: color-mix(in oklab, var(--pri), white 4%);
        border: 1px solid color-mix(in srgb, #fff 10%, transparent);
        --astro-code-background: transparent;
        --astro-code-foreground: var(--on-dark);
        --astro-code-color-background: transparent;
        --astro-code-color-text: var(--on-dark);
        --astro-code-token-keyword: var(--acc);
        --astro-code-token-function: color-mix(in oklab, var(--acc), white 40%);
        --astro-code-token-string: color-mix(in oklab, var(--acc), white 60%);
        --astro-code-token-string-expression: color-mix(in oklab, var(--acc), white 60%);
        --astro-code-token-constant: var(--on-dark);
        --astro-code-token-parameter: var(--on-dark-soft);
        --astro-code-token-punctuation: var(--on-dark-soft);
        --astro-code-token-comment: color-mix(in srgb, var(--on-dark) 45%, transparent);
        --astro-code-token-link: var(--acc);
      }
      .lp-hello-code pre {
        margin: 0;
        padding: 26px 30px;
        overflow-x: auto;
        border-radius: inherit;
        font-size: 12.5px;
        line-height: 1.8;
      }
      .lp-hello-code code {
        font-family: "IBM Plex Mono", monospace;
      }
      .lp-hello-visual {
        position: relative;
        flex: 1;
        min-height: 0;
        border-radius: 14px;
        border: 1px solid color-mix(in srgb, #fff 10%, transparent);
        overflow: hidden;
      }
      .lp-hello-visual img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      /* Overlaid on the image, opposite the attribution icon. */
      .lp-hello-cta {
        position: absolute;
        left: 22px;
        bottom: 16px;
        z-index: 1;
        font-size: 13.5px;
        font-weight: 700;
      }
      .lp .lp-hello-cta a {
        color: var(--acc);
      }
      .lp .lp-hello-cta a:hover {
        color: var(--on-dark);
      }

      .lp-arch {
        padding: 120px 48px;
        background: var(--sub);
        text-align: center;
      }
      /* Diagram composed from the arch-* line-art SVGs. Two grid rows: a shared
         head row (titles) and a fixed-height body row (source pieces → arrows →
         globe). Isolating the bodies in one aligned row keeps the arrow
         convergence, the globe center and the middle source piece on one line,
         no matter how many lines each title wraps to. The arch-* strokes are
         near-black, so this reads as clean line art on the white band. */
      .lp-arch-flow {
        --arch-body-h: clamp(320px, 36vw, 400px);
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(120px, 0.86fr) minmax(0, 1.3fr);
        grid-template-rows: auto var(--arch-body-h);
        grid-template-areas:
          "shead .      rhead"
          "sbody arrows rbody";
        column-gap: clamp(8px, 3vw, 48px);
        row-gap: clamp(18px, 2.6vw, 34px);
        width: min(1060px, 100%);
        margin: clamp(36px, 6vw, 72px) auto 0;
        color: var(--ink);
      }
      /* Titles sit at the bottom of the head row, just above their body. */
      .lp-arch-head {
        align-self: end;
        text-align: center;
      }
      .lp-arch-head.is-source {
        grid-area: shead;
      }
      .lp-arch-head.is-render {
        grid-area: rhead;
      }
      /* Node titles: deliberately larger than the original baked diagram so
         they carry weight within the LP's type scale. */
      .lp-arch-node-title {
        margin: 0;
        font-size: clamp(22px, 2.6vw, 34px);
        font-weight: 680;
        letter-spacing: -0.01em;
        line-height: 1.2;
        text-wrap: balance;
      }
      .lp-arch-node-sub {
        margin: 10px 0 0;
        font-size: clamp(13px, 1.1vw, 15px);
        line-height: 1.55;
        color: var(--ink-soft);
        text-wrap: balance;
      }
      .lp-arch-body {
        min-width: 0;
      }
      .lp-arch-body.is-source {
        grid-area: sbody;
      }
      .lp-arch-body.is-arrows {
        grid-area: arrows;
      }
      .lp-arch-body.is-render {
        grid-area: rbody;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      /* Source pieces in three equal-height slots; each piece is centered in
         its slot, so their centers fall exactly on the arrow origins. */
      .lp-arch-stack {
        display: flex;
        flex-direction: column;
        height: 100%;
      }
      .lp-arch-slot {
        flex: 1 1 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .lp-arch-piece {
        display: block;
        height: auto;
      }
      .lp-arch-p-terrain {
        width: clamp(150px, 20vw, 220px);
      }
      .lp-arch-p-marker {
        width: clamp(30px, 3.4vw, 42px);
      }
      .lp-arch-p-buildings {
        width: clamp(120px, 15vw, 168px);
      }
      /* Converging arrows (arch-arrow.svg). The asset's three sources sit at
         the top / middle / bottom edges of its box; sizing it to 2/3 of the
         body height and centering it maps those onto the source pieces' centers
         (1/6, 1/2, 5/6) while its arrowhead stays on the row's midline — the
         globe center. */
      .lp-arch-arrows {
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .lp-arch-arrow-img {
        display: block;
        height: 66.666%;
        width: auto;
        max-width: 100%;
      }
      /* Rendered globe with the same three pieces composited inside it. Square,
         sized to the body row height (or the cell width when narrower) and
         centered — so its center stays on the row's vertical midline. */
      .lp-arch-globe {
        position: relative;
        width: min(100%, var(--arch-body-h));
        aspect-ratio: 1 / 1;
      }
      .lp-arch-globe-base {
        display: block;
        width: 100%;
        height: 100%;
      }

      /* Gallery — seamless image strip on black; the section title floats
         over the first tile. */
      .lp-gallery {
        background: #000;
      }
      .lp-gallery-head {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 2;
        padding: 44px 48px 96px;
        color: var(--on-dark);
        /* Top scrim so the title reads over any screenshot; clicks pass
           through to the tile underneath. */
        background: linear-gradient(color-mix(in srgb, black 55%, transparent), transparent);
        pointer-events: none;
      }
      .lp-gallery-head .lp-eyebrow {
        color: var(--acc);
      }
      /* Full-bleed image strip with a single overlay label spanning both the
         tutorial and example grids. */
      .lp-gallery-strip {
        position: relative;
      }
      /* The label ink adapts to the tile behind it: a script samples the
         backdrop image's luminance and toggles lp-side-dark to whichever of
         white / theme ink has the higher WCAG contrast (difference blending
         was dropped — it produces mid-gray on mid-gray backdrops). */
      .lp-gallery-side {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        z-index: 2;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        pointer-events: none;
      }
      .lp-gallery-side-inner {
        position: sticky;
        bottom: 28px;
        margin: 28px 0 28px 24px;
        display: grid;
      }
      /* Both label sets are stacked in the same cell and crossfade when the
         overlay crosses into the example grid. */
      .lp-gallery-side-set {
        grid-area: 1 / 1;
        /* Bottom-align both sets so "See more" (and its distance to the screen
           edge) stays put regardless of the vertical label's length — only the
           taller label extends further up. */
        align-self: end;
        opacity: 0;
        transition: opacity 0.35s ease;
        pointer-events: none;
      }
      .lp-gallery-side-set.lp-set-active {
        opacity: 1;
        pointer-events: auto;
      }
      .lp-gallery-label {
        font: 700 16px "IBM Plex Mono", monospace;
        letter-spacing: 0.34em;
        writing-mode: vertical-rl;
        color: var(--on-dark);
        transition: color 0.4s ease;
      }
      .lp-gallery-side.lp-side-dark .lp-gallery-label {
        color: var(--pri);
      }
      .lp-gallery-link {
        margin-top: 26px;
        font-size: 14px;
        font-weight: 700;
      }
      .lp .lp-gallery-link a {
        color: var(--on-dark);
        transition: color 0.4s ease;
      }
      .lp .lp-gallery-side.lp-side-dark .lp-gallery-link a {
        color: var(--pri);
      }
      .lp .lp-gallery-link a:hover {
        text-decoration: underline;
      }
      .lp-tutorial-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }
      /* Grid item wrapping each tile: carries the column-span / height classes
         and hosts the per-tile attribution overlay (a sibling of the link, so
         the info button is never nested inside the tile's <a>). */
      .lp-tile-cell {
        position: relative;
      }
      /* A hovered cell outranks its sibling tiles (while the reveal fade is
         running the cell's opacity is < 1, making it a stacking context that
         the next tile in DOM order would paint over) — but stays under the
         gallery's overlay labels (z-index 2). */
      .lp-tile-cell:hover {
        z-index: 1;
      }
      /* Only while the attribution tooltip is showing (pinned, hovered, or
         keyboard-focused) does the cell outrank the labels as well, so the
         tooltip is never clipped by them. */
      .lp-tile-cell:has(.nv-attrib-open),
      .lp-tile-cell:has(.nv-attrib:hover),
      .lp-tile-cell:has(:focus-visible) {
        z-index: 3;
      }
      .lp-tile {
        position: relative;
        display: block;
        overflow: hidden;
        height: 100%;
      }
      .lp-tile img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      /* Per-tile attribution: top-right (bottom-right would collide with the
         on-hover title). 10px inset gives the Google logo its required top/right
         clear space. No plate — a white icon + shadow reads on any screenshot. */
      .lp-tile-attrib.nv-attrib-tr {
        top: 10px;
        right: 10px;
      }
      .lp-tile-attrib .nv-attrib-btn,
      .lp-tile-attrib .nv-attrib-btn:hover {
        padding: 2px;
        background: none;
        box-shadow: none;
        backdrop-filter: none;
        filter: none;
        color: var(--on-dark);
      }
      /* Over light imagery, flip to dark theme ink (the class is toggled per
         tile by the top-right luminance sampler). */
      .lp-tile-attrib.nv-attrib-ink-dark .nv-attrib-btn,
      .lp-tile-attrib.nv-attrib-ink-dark .nv-attrib-btn:hover {
        color: var(--pri);
      }
      /* Hover lift on linked tiles (the reveal transition keeps transform,
         so hover only touches filter to stay snappy). */
      a.lp-tile {
        cursor: pointer;
      }
      /* The `.lp` prefix lifts specificity above the reveal system's
         `.lp [data-motion="img"] img` rule (which otherwise forces its 2.8s
         entrance-settle transition onto hover too). */
      .lp a.lp-tile img {
        transition:
          filter 0.8s ease,
          transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      .lp a.lp-tile:hover img,
      .lp a.lp-tile:focus-visible img {
        filter: brightness(1.1);
        transform: scale(1.04);
      }
      /* On hover, reveal the example/tutorial name flush in the bottom-right
         corner — always white text on a black plate that meets the tile edges
         (no inset), for consistent legibility over any screenshot. */
      .lp-tile-title {
        position: absolute;
        right: 0;
        bottom: 0;
        z-index: 1;
        max-width: min(100%, 24em);
        text-align: right;
        margin: 0;
        padding: 7px 12px;
        font-size: clamp(13px, 1vw, 16px);
        font-weight: 600;
        line-height: 1.32;
        letter-spacing: 0.01em;
        text-wrap: balance;
        color: var(--on-dark);
        background: rgba(0, 0, 0, 0.72);
        opacity: 0;
        transform: translateY(6px);
        transition:
          opacity 0.24s ease,
          transform 0.24s cubic-bezier(0.2, 0.7, 0.2, 1);
        pointer-events: none;
      }
      a.lp-tile:hover .lp-tile-title,
      a.lp-tile:focus-visible .lp-tile-title {
        opacity: 1;
        transform: translateY(0);
      }
      @media (prefers-reduced-motion: reduce) {
        .lp a.lp-tile:hover img,
        .lp a.lp-tile:focus-visible img {
          transform: none;
        }
        .lp-tile-title {
          transition: opacity 0.24s ease;
          transform: none;
        }
        a.lp-tile:hover .lp-tile-title,
        a.lp-tile:focus-visible .lp-tile-title {
          transform: none;
        }
      }
      .lp-tile-wide {
        grid-column: span 2;
        height: min(48vw, 780px);
      }
      .lp-tile-half {
        height: min(34vw, 560px);
      }
      /* 60-column grid so rows can mix 3:2 (36+24), 1:1:1 (20+20+20),
         2:3 (24+36), and 1:1:1:1 (15x4) — one distinct split per row. */
      .lp-example-grid {
        display: grid;
        grid-template-columns: repeat(60, 1fr);
        grid-auto-rows: min(36vw, 600px);
      }
      .lp-span-15 {
        grid-column: span 15;
      }
      .lp-span-20 {
        grid-column: span 20;
      }
      .lp-span-24 {
        grid-column: span 24;
      }
      .lp-span-36 {
        grid-column: span 36;
      }

      /* MapLibre family */
      .lp-maplibre {
        padding: 120px 48px;
        background: var(--ml);
        color: #fff;
      }
      .lp-maplibre-grid {
        display: grid;
        grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
        gap: 80px;
        align-items: center;
      }
      .lp-maplibre-brand {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .lp-maplibre-logo {
        width: 40px;
        height: 40px;
        flex: none;
      }
      .lp-maplibre-logo-placeholder {
        border: 1px dashed color-mix(in oklab, var(--ml), white 40%);
        border-radius: 8px;
        box-sizing: border-box;
      }
      .lp-maplibre-h2 {
        margin: 14px 0 24px;
        font: 700 48px "Arsenal", "Zen Kaku Gothic New", sans-serif;
      }
      .lp-maplibre-copy {
        margin-bottom: 36px;
        font-size: 15px;
        line-height: 2;
        color: color-mix(in oklab, var(--ml), white 80%);
        text-wrap: pretty;
      }
      .lp-maplibre-list {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 16px;
        font-size: 14px;
      }
      .lp-maplibre-list li {
        display: flex;
        gap: 10px;
      }
      .lp-maplibre-list li .lp-maplibre-check {
        flex: 0 0 auto;
        margin-top: 3px;
        color: color-mix(in oklab, var(--ml), white 60%);
      }
      .lp-maplibre-roadmap {
        margin-top: 32px;
        font-size: 13px;
      }
      .lp .lp-maplibre-roadmap a {
        color: #fff;
        text-decoration: underline;
      }
      .lp .lp-maplibre-roadmap a:hover {
        color: color-mix(in oklab, var(--ml), white 70%);
      }
      .lp-maplibre-visual {
        position: relative;
        min-height: 560px;
        /* Clip the reveal scale-settle to the rounded frame. */
        overflow: hidden;
        border-radius: 14px;
      }
      .lp-maplibre-visual img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 14px;
      }
      /* No plate; theme ink reads on the light basemap still. This section has
         no luminance sampler, so the ink is fixed (the still is always light). */
      .lp-maplibre-visual .nv-attrib-btn,
      .lp-maplibre-visual .nv-attrib-btn:hover {
        background: none;
        box-shadow: none;
        backdrop-filter: none;
        color: var(--pri);
      }

      /* Get started (footer) */
      /* Closing call to action: a roomy band of its own, with the glow-globe
         example still behind it; the scrim dims it for contrast and fades its
         edges into the band. The hairline on the footer below keeps the two
         from reading as one block. */
      /* The closing band: one canvas holding the outro CTA and the footer,
         with the glow-globe still spanning both. */
      .lp-close {
        /* Not a theme color: matched to the baked glow-globe screenshot's
           own background (sampled pure black), so image and band are one. */
        --outro-bg: #000;
        position: relative;
        overflow: hidden;
        background: var(--outro-bg);
      }
      /* The footer is lifted out of flow (absolute, bottom) so the band's
         height — and the image and vignette centered in it — is set by the
         outro alone. One screen tall (minus the 68px fixed header), with the
         content flex-centered; the symmetric padding keeps it clear of the
         overlaid footer on short viewports. */
      .lp-outro {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        min-height: calc(100svh - var(--lp-header-h, 68px));
        padding: 150px 48px;
        text-align: center;
      }
      /* Height-driven sizing: the still is always 115% of the band's height
         (its globe fills ~95% of the frame, so it slightly overflows top and
         bottom), centered — the composition is identical on every screen. */
      .lp-outro-bg {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: auto;
        height: 115%;
      }
      /* Radial vignette: dims the middle a touch for text contrast and takes
         every edge fully to the band color, so the contained image's frame
         never shows. */
      .lp-outro-scrim {
        position: absolute;
        inset: 0;
        background: var(--outro-bg);
        opacity: 0.5;
      }
      .lp-outro-content {
        position: relative;
        z-index: 1;
      }
      .lp-outro-h2 {
        font: 700 48px "Arsenal", "Zen Kaku Gothic New", sans-serif;
        color: var(--on-dark);
      }
      .lp-outro-ctas {
        justify-content: center;
        margin-top: 40px;
      }

      .lp-footer {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1;
        padding: 56px 48px 48px;
        color: var(--on-dark);
        text-align: center;
      }
      .lp-footer-links {
        display: flex;
        justify-content: center;
        gap: 26px;
        font-size: 14px;
        font-weight: 500;
      }
      .lp .lp-footer-links a {
        color: var(--on-dark);
      }
      .lp .lp-footer-links a:hover {
        color: var(--acc);
      }
      .lp-footer-credit {
        margin-top: 28px;
        font-size: 12px;
        color: var(--on-dark-soft);
      }

      /* Responsive — the desktop composition is the reference; tablets tighten
         spacing and stack the widest grids, phones stack everything and turn
         the gallery into a horizontal scroller that preserves the desktop
         layout at a fixed 900px composition width. */
      @media (max-width: 960px) {
        .lp-header {
          padding: 18px 28px;
        }
        .lp-intro {
          padding: 72px 32px 60px;
        }
        .lp-intro-grid {
          grid-template-columns: 1fr;
          gap: 36px;
        }
        .lp-intro-right {
          padding-top: 0;
        }
        .lp-why {
          padding: 96px 32px 0;
        }
        .lp-values {
          grid-template-columns: 1fr 1fr;
          column-gap: 48px;
          row-gap: 40px;
        }
        /* image showcase (641–960): a taller frame, a narrower caption and a
           smaller ring so the bottom-left caption and bottom-right ring stop
           colliding as the width shrinks (the ≤640 block takes over below) */
        .lp-api-media {
          aspect-ratio: 3 / 2;
        }
        .lp-api-caps {
          max-width: 62%;
        }
        .lp-api-cap-scene {
          display: block;
          margin-left: 0;
          margin-top: 4px;
        }
        .lp-api-ring {
          transform: scale(0.94);
        }
        .lp-hello {
          padding: 88px 32px;
        }
        /* Single column: the result first, code under it. minmax(0, …) lets
           the long code lines scroll inside the card instead of widening it
           past the viewport. Stacked, nothing drives the stretched image
           height, so pin the visual to the source ratio. */
        .lp-hello-grid {
          grid-template-columns: minmax(0, 1fr);
          gap: 36px;
        }
        .lp-hello-side {
          order: -1;
        }
        .lp-hello-visual {
          flex: none;
          aspect-ratio: 16 / 9;
        }
        .lp-arch {
          padding: 88px 32px;
        }
        .lp-gallery-head {
          padding: 36px 32px 80px;
        }
        .lp-maplibre {
          padding: 88px 32px;
        }
        .lp-maplibre-grid {
          grid-template-columns: 1fr;
          gap: 36px;
        }
        .lp-outro {
          padding: 130px 32px;
        }
        /* On a narrow portrait viewport, fill the band instead (the sides
           crop). */
        .lp-outro-bg {
          left: 0;
          top: 0;
          transform: none;
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
        /* Sized so the title holds one line on a 390px viewport. */
        .lp-outro-h2 {
          font-size: 24px;
        }
        .lp-footer {
          padding: 44px 32px 40px;
        }
      }

      @media (max-width: 640px) {
        .lp-header {
          padding: 14px 20px;
        }
        .lp-nav {
          gap: 18px;
        }
        /* Docs/Examples text links don't fit; both stay reachable from the
           footer. */
        .lp-nav > a:not([class]) {
          display: none;
        }
        .lp-wordmark {
          font-size: 19px;
        }

        .lp-intro {
          padding: 52px 20px 44px;
        }
        .lp-h1 {
          font-size: 38px;
        }
        .lp-h1-sub {
          margin-top: 14px;
          font-size: 14px;
        }

        .lp-why {
          padding: 72px 20px 0;
        }
        .lp-why-h2 {
          margin-top: 12px;
          font-size: 32px;
          line-height: 1.45;
        }
        .lp-values {
          grid-template-columns: 1fr;
          gap: 28px;
          margin-top: 48px;
        }
        .lp-api-tiers {
          margin-top: 56px;
        }
        /* cap the height so wider phones don't stretch the still so tall that
           the ring and the bottom caption drift far apart */
        .lp-api-media {
          aspect-ratio: 4 / 5;
          max-height: 640px;
        }
        .lp-api-lede {
          max-width: 60%;
          padding: 18px 18px 0;
        }
        /* compact caption near the bottom edge on phones */
        .lp-api-caps {
          max-width: 100%;
          padding: 0 18px 18px;
        }
        .lp-api-cap-title {
          font-size: 16px;
        }
        .lp-api-cap-scene {
          font-size: 12px;
          margin-top: 3px;
        }
        .lp-api-cap-desc {
          margin-top: 8px;
          font-size: 12.5px;
          line-height: 1.5;
        }
        /* on phones the top-left lede and bottom-left caption own the two
           corners, so pin the ring to the right edge just above the caption,
           so it stays close to the text at any phone height */
        .lp-api-ring {
          right: 4px;
          top: auto;
          bottom: 100px;
          transform: scale(0.76);
          transform-origin: bottom right;
        }

        .lp-hello {
          padding: 72px 20px;
        }
        .lp-hello-code pre {
          padding: 20px 22px;
          font-size: 11.5px;
        }
        .lp-hello-cta {
          left: 16px;
          bottom: 12px;
        }
        .lp-arch {
          padding: 72px 6px;
        }
        .lp-h2 {
          font-size: 30px;
        }
        /* Vertical flow on phones, mirroring the original SP diagram: source
           pieces in a row, converging arrows pointing down, then the globe.
           Drop the desktop two-row grid so the cells auto-place down a single
           column in DOM order (head → pieces → arrows → head → globe). */
        .lp-arch-flow {
          /* The wider terrain sits on the left, so the pieces group reads as
             left-leaning even with the marker centred. Nudge the group AND the
             arrow right by the same amount so they stay mutually aligned while
             the group looks centred (the globe stays column-centred). */
          --arch-shift: clamp(0px, 2vw, 15px);
          grid-template-columns: 1fr;
          grid-template-rows: none;
          grid-template-areas: none;
          row-gap: clamp(20px, 6vw, 36px);
          width: min(480px, 100%);
          margin-top: 24px;
        }
        /* Shift the group right via inside padding (not a transform on the
           full-width box) so it never bleeds past the viewport. padding-left of
           2×shift moves the centred marker right by exactly one shift. */
        .lp-arch-body.is-source {
          padding-left: calc(2 * var(--arch-shift));
        }
        /* Drop the desktop grid-area placement so the cells auto-stack down the
           single column in DOM order (matching-specificity reset). */
        .lp-arch-flow .lp-arch-head,
        .lp-arch-flow .lp-arch-body {
          grid-area: auto;
        }
        .lp-arch-head {
          align-self: auto;
        }
        /* Grid with equal, freely-shrinking side tracks (minmax(0,1fr)) and an
           auto centre track keeps the middle piece (marker) exactly on the
           column's centre line — so it aligns with the arrow's centre —
           regardless of the terrain/buildings widths. */
        .lp-arch-stack {
          display: grid;
          grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
          align-items: end;
          column-gap: clamp(20px, 6vw, 40px);
          height: auto;
        }
        .lp-arch-slot:nth-child(1) {
          justify-content: flex-end;
        }
        .lp-arch-slot:nth-child(3) {
          justify-content: flex-start;
        }
        /* Terrain / buildings hug the marker and never exceed their track. */
        .lp-arch-piece {
          max-width: 100%;
        }
        /* Larger source pieces so the group carries similar visual weight to
           the globe. */
        .lp-arch-p-terrain {
          width: clamp(150px, 40vw, 200px);
        }
        .lp-arch-p-marker {
          width: clamp(34px, 9vw, 48px);
        }
        .lp-arch-p-buildings {
          width: clamp(120px, 32vw, 158px);
        }
        .lp-arch-body.is-render {
          justify-content: center;
        }
        /* Globe a touch smaller than full width, balanced against the pieces. */
        .lp-arch-globe {
          width: min(84%, 350px);
        }
        /* Rotate the same arrow asset 90° so it points down. Fixed-height,
           absolutely-centered cell so the rotated box doesn't distort layout. */
        .lp-arch-body.is-arrows {
          position: relative;
          height: clamp(140px, 38vw, 190px);
        }
        .lp-arch-arrow-img {
          position: absolute;
          top: 50%;
          left: 50%;
          height: auto;
          width: clamp(140px, 38vw, 190px);
          max-width: none;
          transform: translate(calc(-50% + var(--arch-shift)), -50%) rotate(90deg);
        }

        .lp-gallery-head {
          padding: 24px 20px 56px;
        }
        /* The grids keep their desktop composition at 900px and the overflow
           scrolls sideways; the label overlay lives outside the scroller, so
           it stays pinned to the viewport edge while images pass under it. */
        .lp-gallery-scroll {
          overflow-x: auto;
          scrollbar-width: none;
        }
        .lp-gallery-scroll::-webkit-scrollbar {
          display: none;
        }
        .lp-tutorial-grid,
        .lp-example-grid {
          width: 900px;
        }
        .lp-tile-wide {
          height: 440px;
        }
        .lp-tile-half {
          height: 300px;
        }
        .lp-example-grid {
          grid-auto-rows: 320px;
        }
        .lp-gallery-side-inner {
          margin: 20px 0 20px 12px;
          bottom: 20px;
        }
        .lp-gallery-label {
          font-size: 13px;
          letter-spacing: 0.3em;
        }
        .lp-gallery-link {
          margin-top: 18px;
          font-size: 13px;
        }

        .lp-maplibre {
          padding: 72px 20px;
        }
        .lp-maplibre-h2 {
          font-size: 30px;
        }
        .lp-maplibre-visual {
          min-height: 300px;
        }

        .lp-footer {
          padding: 48px 20px 40px;
        }
        .lp-footer-links {
          flex-wrap: wrap;
          gap: 18px 22px;
        }
      }
    </style>
  </body>
</html>
