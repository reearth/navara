---
// Landing page for Navara. Design reference: design_handoff_navara_landing_page.
// Theme colors, image slots, and external links are managed in src/data/lp.json;
// all copy lives in src/data/lp-locales/<locale>.json. To add a locale, create
// its strings file there and a page that renders <LandingPage locale="..." />.
// Image `src` values are repo-root-relative paths pointing into docs/src/assets
// or web/navara_three/example/public/screenshots.
import type { ImageMetadata } from "astro";
import { ArrowUpRight, ChevronDown, Globe } from "@lucide/astro";
import lp from "../data/lp.json";
import ImageAttribution from "./ImageAttribution.astro";
import githubIcon from "../assets/lp/github-invertocat.svg?raw";
import archGlobe from "../assets/lp/arch-globe.svg?url";
import archTerrain from "../assets/lp/arch-terrain.svg?url";
import archBuildings from "../assets/lp/arch-buildings.svg?url";
import archMarker from "../assets/lp/arch-marker.svg?url";
import archArrow from "../assets/lp/arch-arrow.svg?url";

interface Props {
  locale: string;
}

// The root locale is served at "/" without a path prefix (matches Starlight).
const ROOT_LOCALE = "en";

const localeModules = import.meta.glob<{ default: any }>("../data/lp-locales/*.json", {
  eager: true,
});
const locales: Record<string, any> = {};
for (const [path, mod] of Object.entries(localeModules)) {
  const code = path.match(/([\w-]+)\.json$/)?.[1];
  if (code) locales[code] = mod.default;
}

const { locale } = Astro.props;
const t = locales[locale];
if (!t) throw new Error(`LP locale strings not found: ${locale}`);

// Prefix internal links with the locale path segment (root locale has none).
function localizeHref(href: string): string {
  if (!href.startsWith("/") || locale === ROOT_LOCALE) return href;
  return `/${locale}${href}`;
}
// Pre-release the LP is parked under /lp (the docs top pages own the locale
// roots); at release this returns to the locale roots — see astro.config.mjs.
const lpPathOf = (code: string): string => (code === ROOT_LOCALE ? "/lp/" : `/${code}/lp/`);

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  [
    "../assets/**/*.{png,jpg,jpeg,gif,webp,avif,svg}",
    "../../../web/navara_three/example/public/screenshots/**/*.{png,jpg,jpeg,gif,webp,avif}",
  ],
  { eager: true },
);

interface ImageSlot {
  src: string | null;
  href?: string;
}

// Resolve a repo-root-relative path from lp.json to a bundled asset URL.
function resolveImage(imageSlot: ImageSlot): string | null {
  if (!imageSlot.src) return null;
  const key = imageSlot.src.startsWith("docs/src/")
    ? imageSlot.src.replace("docs/src/", "../")
    : `../../../${imageSlot.src}`;
  const mod = imageModules[key];
  if (!mod) throw new Error(`LP image not found: ${imageSlot.src}`);
  return mod.default.src;
}

const images = lp.images as Record<string, ImageSlot>;
const slot = (id: string): ImageSlot => {
  const s = images[id];
  if (!s) throw new Error(`LP image slot not defined in lp.json: ${id}`);
  return s;
};
const src = (id: string): string | null => resolveImage(slot(id));
// Alt text is copy, so it lives with the locale strings (imageAlts, keyed by slot id).
const alt = (id: string): string => {
  const text = t.imageAlts?.[id];
  if (text === undefined) throw new Error(`LP image alt not defined for locale "${locale}": ${id}`);
  return text;
};

const { colors, links } = lp;
const rootStyle = `--pri:${colors.primary};--acc:${colors.accent};--sub:${colors.sub};--ml:${colors.maplibre}`;
---

<html lang={t.htmlLang} style={rootStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    {/* TODO: Remove when Navara is released. */}
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Arsenal:wght@400;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="lp">
      <!-- Transparent header over hero -->
      <header class="lp-header">
        <span class="lp-wordmark">NAVARA</span>
        <nav class="lp-nav">
          <a href={localizeHref(links.docs)}>{t.nav.docs}</a>
          <a href={links.examples}>{t.nav.examples}</a>
          <a
            class="lp-nav-github"
            href={links.github}
            aria-label={t.nav.github}
            set:html={githubIcon}
          />
          <label class="lp-lang">
            <Globe size={16} stroke-width={1.8} aria-hidden="true" />
            <select aria-label="Language" data-lp-lang>
              {
                Object.entries(locales).map(([code, strings]: [string, any]) => (
                  <option value={lpPathOf(code)} selected={code === locale} lang={strings.htmlLang}>
                    {strings.short}
                  </option>
                ))
              }
            </select>
            <ChevronDown class="lp-lang-chevron" size={14} stroke-width={2} aria-hidden="true" />
          </label>
          <a class="lp-nav-cta" href="#get-started">{t.nav.getStarted}</a>
        </nav>
      </header>

      <!-- Hero stage: the hero image stays pinned while the transparent
           catch-copy section slides up over it; once that section is fully
           visible the page scrolls normally again. -->
      <div class="lp-hero-stage">
        <div class="lp-hero">
          {src("hero") && <img src={src("hero")} alt={alt("hero")} />}
        </div>
        <!-- Catch copy + intro -->
        <section class="lp-intro">
        <div class="lp-container lp-intro-grid">
          <div>
            <h1 class="lp-h1" set:html={t.intro.h1Html} />
            {t.intro.h1Sub && <p class="lp-h1-sub">{t.intro.h1Sub}</p>}
          </div>
          <div class="lp-intro-right">
            <p class="lp-intro-copy" set:html={t.intro.copyHtml} />
            <div class="lp-cta-row">
              <a class="lp-btn-primary" href={links.examples}>{t.intro.ctaShowcase}</a>
              <a class="lp-btn-outline" href={localizeHref(links.docs)}>{t.intro.ctaDocs}</a>
            </div>
            <p class="lp-getting-started">
              <a href={localizeHref(links.gettingStarted)}
                >{t.intro.gettingStarted}<ArrowUpRight class="lp-link-icon" size={15} /></a
              >
            </p>
          </div>
        </div>
        </section>
      </div>

      <div class="lp-main">
      <!-- Why Navara -->
      <section class="lp-why">
        <div class="lp-container">
          <p class="lp-eyebrow lp-eyebrow-center" data-reveal>{t.why.eyebrow}</p>
          <h2 class="lp-why-h2" data-reveal style="--rd:1" set:html={t.why.h2Html} />
          <div class="lp-values" data-reveal-group>
            {
              t.why.values.map((value: any) => (
                <div>
                  <h3>{value.title}</h3>
                  <p>{value.desc}</p>
                </div>
              ))
            }
          </div>
          <!-- API tiers: one media showcase. The still cross-fades through
               the four tiers (why-tier-1..4); an editorial open ring sits in
               the corner with Declarative at its core and Plugin / API /
               Shader on the ring, and the caption + the glowing ring label
               highlight in sync. Auto-advances on screen; click a ring label
               to jump. Stills are lp.json slots, swappable without touching
               this markup. -->
          <div class="lp-api-tiers">
            <div class="lp-api-stage" data-reveal>
              <div class="lp-api-media">
                {
                  t.why.apiSegments.map((_seg: any, i: number) => (
                    <img
                      src={src(`why-tier-${i + 1}`)}
                      alt={alt(`why-tier-${i + 1}`)}
                      class={i === 0 ? "lp-tier-visible" : undefined}
                      loading="lazy"
                      decoding="async"
                    />
                  ))
                }
                <div class="lp-api-scrim" aria-hidden="true" />
                <div class="lp-api-lede">
                  <h3 class="lp-api-lede-title">{t.why.apiLede.title}</h3>
                  <p class="lp-api-lede-sub">{t.why.apiLede.sub}</p>
                </div>
                <ImageAttribution
                  items={t.why.mediaAttribution}
                  label={t.why.mediaAttributionLabel}
                  corner="tr"
                />
                <div class="lp-api-caps">
                  {
                    t.why.apiSegments.map((seg: any, i: number) => (
                      <div
                        class={`lp-api-cap${i === 0 ? " lp-tier-active" : ""}`}
                      >
                        <p class="lp-api-cap-title">
                          {seg.label}
                          <span class="lp-api-cap-scene">{seg.scene}</span>
                        </p>
                        <p class="lp-api-cap-desc">{seg.desc}</p>
                      </div>
                    ))
                  }
                </div>
                <div class="lp-api-ring">
                  <svg viewBox="0 0 240 240" aria-hidden="true">
                    <path
                      class="lp-api-track"
                      d="M156 31 A96 96 0 0 1 208.4 157.5"
                    />
                    <path
                      class="lp-api-track"
                      d="M172.3 200.5 A96 96 0 0 1 77.9 206.3"
                    />
                    <path class="lp-api-track" d="M27.7 146.5 A96 96 0 0 1 84 31" />
                  </svg>
                  <button
                    type="button"
                    class="lp-api-node lp-node-dec lp-tier-active"
                    data-tier="0"
                  >
                    <span>{t.why.apiSegments[0].label}</span>
                  </button>
                  <button
                    type="button"
                    class="lp-api-node lp-node-plugin"
                    data-tier="1"
                  >
                    <span>{t.why.apiSegments[1].label}</span>
                  </button>
                  <button
                    type="button"
                    class="lp-api-node lp-node-api"
                    data-tier="2"
                  >
                    <span>{t.why.apiSegments[2].label}</span>
                  </button>
                  <button
                    type="button"
                    class="lp-api-node lp-node-shader"
                    data-tier="3"
                  >
                    <span>{t.why.apiSegments[3].label}</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Architecture (light) -->
      <section class="lp-arch">
        <div class="lp-container">
          <p class="lp-eyebrow" data-reveal>{t.arch.eyebrow}</p>
          <h2 class="lp-h2" data-reveal style="--rd:1">{t.arch.h2}</h2>
          <p class="lp-arch-sub" data-reveal style="--rd:2">{t.arch.sub}</p>
          {/* The diagram is composed from the arch-* line-art SVGs rather than
              a baked image: source geometry (terrain / marker / buildings) on
              the left flows through converging arrows into the globe the
              renderer draws on the right. Pieces are decorative (alt=""); the
              node titles/subs carry the meaning. */}
          {/* Two grid rows: the titles sit in a shared head row and the visual
              bodies (source pieces / arrows / globe) in a body row of fixed
              height. Keeping the bodies in one aligned row is what lets the
              arrows converge on the globe's center regardless of how many lines
              each title wraps to. DOM order = the mobile (single-column) flow;
              desktop re-places the cells via grid-template-areas. */}
          <div
            class="lp-arch-flow"
            data-reveal
            style="--rd:3"
            role="img"
            aria-label={t.arch.diagramAlt}
          >
            <div class="lp-arch-head is-source">
              <h3 class="lp-arch-node-title">{t.arch.sourceTitle}</h3>
              <p class="lp-arch-node-sub">{t.arch.sourceSub}</p>
            </div>

            {/* Source pieces in equal-height slots so their centers land at
                1/6, 1/2, 5/6 of the body height — exactly the arrow origins. */}
            <div class="lp-arch-body is-source lp-arch-stack">
              <div class="lp-arch-slot">
                <img class="lp-arch-piece lp-arch-p-terrain" src={archTerrain} alt="" />
              </div>
              <div class="lp-arch-slot">
                <img class="lp-arch-piece lp-arch-p-marker" src={archMarker} alt="" />
              </div>
              <div class="lp-arch-slot">
                <img class="lp-arch-piece lp-arch-p-buildings" src={archBuildings} alt="" />
              </div>
            </div>

            {/* Converging arrows (arch-arrow.svg): points right on desktop;
                the same asset is rotated 90° to point down on mobile. */}
            <div class="lp-arch-body is-arrows lp-arch-arrows" aria-hidden="true">
              <img class="lp-arch-arrow-img" src={archArrow} alt="" />
            </div>

            <div class="lp-arch-head is-render">
              <h3 class="lp-arch-node-title">{t.arch.renderTitle}</h3>
              <p class="lp-arch-node-sub">{t.arch.renderSub}</p>
            </div>

            <div class="lp-arch-body is-render">
              {/* arch-globe.svg already contains the composited scene (terrain,
                  buildings, marker inside the globe) — nothing is overlaid. */}
              <div class="lp-arch-globe">
                <img class="lp-arch-globe-base" src={archGlobe} alt="" />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Gallery — Tutorial & Example -->
      <section class="lp-gallery">
        <div class="lp-gallery-strip">
          <!-- Section title overlays the first tile; a top scrim keeps it
               readable over any screenshot. -->
          <div class="lp-gallery-head" data-reveal-group>
            <p class="lp-eyebrow">{t.gallery.eyebrow}</p>
            <h2 class="lp-h2">{t.gallery.h2}</h2>
          </div>
          <aside class="lp-gallery-side">
            <div class="lp-gallery-side-inner">
              <div class="lp-gallery-side-set lp-set-active" data-gallery-set="tutorial">
                <p class="lp-gallery-label">{t.gallery.tutorial.label}</p>
                <p class="lp-gallery-link">
                  <a href={localizeHref(links.tutorial)}
                    >{t.gallery.tutorial.link}<ArrowUpRight class="lp-link-icon" size={15} /></a
                  >
                </p>
              </div>
              <div class="lp-gallery-side-set" data-gallery-set="example">
                <p class="lp-gallery-label">{t.gallery.example.label}</p>
                <p class="lp-gallery-link">
                  <a href={links.examples}
                    >{t.gallery.example.link}<ArrowUpRight class="lp-link-icon" size={15} /></a
                  >
                </p>
              </div>
            </div>
          </aside>
          <!-- On phones this wrapper scrolls horizontally so the grids keep
               their desktop composition; the label overlay stays outside the
               scroller, pinned to the viewport edge. -->
          <div class="lp-gallery-scroll">
          <div class="lp-tutorial-grid">
            <a
              class="lp-tile lp-tile-wide"
              data-reveal
              data-motion="img"
              href={localizeHref(slot("tutorial-wide").href ?? links.tutorial)}
            >
              {src("tutorial-wide") && <img src={src("tutorial-wide")} alt={alt("tutorial-wide")} />}
            </a>
            <a
              class="lp-tile lp-tile-half"
              data-reveal
              data-motion="img"
              href={localizeHref(slot("tutorial-left").href ?? links.tutorial)}
            >
              {src("tutorial-left") && <img src={src("tutorial-left")} alt={alt("tutorial-left")} />}
            </a>
            <a
              class="lp-tile lp-tile-half"
              data-reveal
              data-motion="img"
              style="--rd:1"
              href={localizeHref(slot("tutorial-right").href ?? links.tutorial)}
            >
              {src("tutorial-right") && <img src={src("tutorial-right")} alt={alt("tutorial-right")} />}
            </a>
          </div>
          <div class="lp-example-grid">
          <!-- Row 1 — 3:2 -->
          <a class="lp-tile lp-span-36" data-reveal data-motion="img" href={slot("example-row1-left").href ?? links.examples}>
            {src("example-row1-left") && <img src={src("example-row1-left")} alt={alt("example-row1-left")} />}
          </a>
          <a class="lp-tile lp-span-24" data-reveal data-motion="img" style="--rd:1" href={slot("example-row1-right").href ?? links.examples}>
            {src("example-row1-right") && <img src={src("example-row1-right")} alt={alt("example-row1-right")} />}
          </a>
          <!-- Row 2 — 1:1:1 -->
          <a class="lp-tile lp-span-20" data-reveal data-motion="img" href={slot("example-row2-left").href ?? links.examples}>
            {src("example-row2-left") && <img src={src("example-row2-left")} alt={alt("example-row2-left")} />}
          </a>
          <a class="lp-tile lp-span-20" data-reveal data-motion="img" style="--rd:1" href={slot("example-row2-center").href ?? links.examples}>
            {src("example-row2-center") && <img src={src("example-row2-center")} alt={alt("example-row2-center")} />}
          </a>
          <a class="lp-tile lp-span-20" data-reveal data-motion="img" style="--rd:2" href={slot("example-row2-right").href ?? links.examples}>
            {src("example-row2-right") && <img src={src("example-row2-right")} alt={alt("example-row2-right")} />}
          </a>
          <!-- Row 3 — 2:3 -->
          <a class="lp-tile lp-span-24" data-reveal data-motion="img" href={slot("example-row3-left").href ?? links.examples}>
            {src("example-row3-left") && <img src={src("example-row3-left")} alt={alt("example-row3-left")} />}
          </a>
          <a class="lp-tile lp-span-36" data-reveal data-motion="img" style="--rd:1" href={slot("example-row3-right").href ?? links.examples}>
            {src("example-row3-right") && <img src={src("example-row3-right")} alt={alt("example-row3-right")} />}
          </a>
          <!-- Row 4 — 3:3:2:2 -->
          <a class="lp-tile lp-span-15" data-reveal data-motion="img" href={slot("example-row4-left").href ?? links.examples}>
            {src("example-row4-left") && <img src={src("example-row4-left")} alt={alt("example-row4-left")} />}
          </a>
          <a class="lp-tile lp-span-15" data-reveal data-motion="img" style="--rd:1" href={slot("example-row4-center-left").href ?? links.examples}>
            {src("example-row4-center-left") && <img src={src("example-row4-center-left")} alt={alt("example-row4-center-left")} />}
          </a>
          <a class="lp-tile lp-span-15" data-reveal data-motion="img" style="--rd:2" href={slot("example-row4-center-right").href ?? links.examples}>
            {src("example-row4-center-right") && <img src={src("example-row4-center-right")} alt={alt("example-row4-center-right")} />}
          </a>
          <a class="lp-tile lp-span-15" data-reveal data-motion="img" style="--rd:3" href={slot("example-row4-right").href ?? links.examples}>
            {src("example-row4-right") && <img src={src("example-row4-right")} alt={alt("example-row4-right")} />}
          </a>
          </div>
          </div>
        </div>
      </section>

      <!-- MapLibre family -->
      <section class="lp-maplibre">
        <div class="lp-container lp-maplibre-grid">
          <div data-reveal-group>
            <div class="lp-maplibre-brand">
              {
                src("maplibre-logo") ? (
                  <img
                    class="lp-maplibre-logo"
                    src={src("maplibre-logo")}
                    alt={alt("maplibre-logo")}
                  />
                ) : (
                  <div class="lp-maplibre-logo lp-maplibre-logo-placeholder" />
                )
              }
              <p class="lp-eyebrow lp-eyebrow-ml">{t.maplibre.eyebrow}</p>
            </div>
            <h2 class="lp-maplibre-h2">{t.maplibre.h2}</h2>
            <p class="lp-maplibre-copy">{t.maplibre.copy}</p>
            <ul class="lp-maplibre-list">
              {
                t.maplibre.items.map((item: string) => (
                  <li>
                    <span>—</span>
                    {item}
                  </li>
                ))
              }
            </ul>
            <p class="lp-maplibre-roadmap">
              <a href={localizeHref(links.roadmap)}
                >{t.maplibre.roadmap}<ArrowUpRight class="lp-link-icon" size={15} /></a
              >
            </p>
          </div>
          <div class="lp-maplibre-visual" data-reveal data-motion="img">
            {src("maplibre-visual") && <img src={src("maplibre-visual")} alt={alt("maplibre-visual")} />}
          </div>
        </div>
      </section>

      <!-- Get started (footer) -->
      <footer id="get-started" class="lp-footer" data-reveal-group>
        <h2>{t.footer.h2}</h2>
        <a class="lp-footer-cta" href={localizeHref(links.gettingStarted)}>{t.footer.cta}</a>
        <div class="lp-footer-links">
          <a href={localizeHref(links.docs)}>{t.footer.docs}</a>
          <a href={links.github}>{t.footer.github}</a>
          <a href={links.discord}>{t.footer.discord}</a>
        </div>
        <p class="lp-footer-credit">{t.footer.credit}</p>
      </footer>
      </div>
    </div>

    <script>
      // Navigate to the selected locale's landing page.
      document.querySelectorAll<HTMLSelectElement>("select[data-lp-lang]").forEach((el) => {
        el.addEventListener("change", () => {
          location.href = el.value;
        });
      });

      // Measure the catch-copy height so its sticky pin line sits exactly at
      // "fully revealed" (see .lp-intro's top calc).
      const stage = document.querySelector<HTMLElement>(".lp-hero-stage");
      const intro = document.querySelector<HTMLElement>(".lp-intro");
      if (stage && intro) {
        const setIntroHeight = () =>
          stage.style.setProperty("--lp-intro-h", `${intro.offsetHeight}px`);
        setIntroHeight();
        window.addEventListener("resize", setIntroHeight);
      }

      // Give the fixed header a dark backdrop once the hero has scrolled away.
      const header = document.querySelector(".lp-header");
      const hero = document.querySelector(".lp-hero");
      if (header && hero) {
        const headerObserver = new IntersectionObserver(([entry]) => {
          header.classList.toggle("lp-header-solid", !entry.isIntersecting);
        });
        headerObserver.observe(hero);
      }

      // Crossfade the gallery overlay label when it crosses into the example
      // grid (and back, when scrolling up).
      const exampleGrid = document.querySelector(".lp-example-grid");
      const gallerySets = document.querySelectorAll<HTMLElement>(".lp-gallery-side-set");
      if (exampleGrid && gallerySets.length) {
        const galleryObserver = new IntersectionObserver(
          ([entry]) => {
            const active = entry.isIntersecting ? "example" : "tutorial";
            gallerySets.forEach((set) => {
              set.classList.toggle("lp-set-active", set.dataset.gallerySet === active);
            });
          },
          // Shrink the viewport bottom to roughly the overlay label position,
          // so the swap happens as the label meets the example images.
          { rootMargin: "0px 0px -140px 0px" },
        );
        galleryObserver.observe(exampleGrid);
      }

      // Adaptive gallery label ink: sample the luminance of the tile image
      // behind the sticky label and switch between white and the theme ink,
      // picking whichever has the higher WCAG contrast. This also covers
      // mid-gray backdrops, where neither pure inversion nor a fixed color
      // works well — the better of the two candidates always wins.
      const gallerySide = document.querySelector<HTMLElement>(".lp-gallery-side");
      const gallerySideInner = document.querySelector<HTMLElement>(".lp-gallery-side-inner");
      if (gallerySide && gallerySideInner) {
        // Linearize an sRGB channel (0-255) for relative-luminance math.
        const linear = (c: number): number => {
          const s = c / 255;
          return s <= 0.04045 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
        };
        const contrast = (a: number, b: number): number =>
          (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
        // Luminance of the theme ink (--pri, always #rrggbb from lp.json).
        const priHex = getComputedStyle(document.documentElement)
          .getPropertyValue("--pri")
          .trim();
        const priLum =
          0.2126 * linear(parseInt(priHex.slice(1, 3), 16)) +
          0.7152 * linear(parseInt(priHex.slice(3, 5), 16)) +
          0.0722 * linear(parseInt(priHex.slice(5, 7), 16));

        // Average luminance of the left quarter of the image's VISIBLE crop —
        // tiles render with object-fit: cover, so the displayed region must be
        // derived from the tile's aspect ratio before sampling. Sampled once
        // per image on a small canvas.
        const lumCache = new WeakMap<HTMLImageElement, number>();
        const luminanceOf = (img: HTMLImageElement): number | null => {
          const cached = lumCache.get(img);
          if (cached !== undefined) return cached;
          if (!img.complete || !img.naturalWidth) return null;
          const canvas = document.createElement("canvas");
          canvas.width = 12;
          canvas.height = 24;
          const ctx = canvas.getContext("2d", { willReadFrequently: true });
          if (!ctx) return null;
          // Source rect actually shown by object-fit: cover (centered crop).
          const scale = Math.max(
            img.clientWidth / img.naturalWidth,
            img.clientHeight / img.naturalHeight,
          );
          const visW = img.clientWidth / scale || img.naturalWidth;
          const visH = img.clientHeight / scale || img.naturalHeight;
          const sx = (img.naturalWidth - visW) / 2;
          const sy = (img.naturalHeight - visH) / 2;
          ctx.drawImage(img, sx, sy, visW / 4, visH, 0, 0, 12, 24);
          const data = ctx.getImageData(0, 0, 12, 24).data;
          let sum = 0;
          for (let i = 0; i < data.length; i += 4) {
            sum +=
              0.2126 * linear(data[i]) +
              0.7152 * linear(data[i + 1]) +
              0.0722 * linear(data[i + 2]);
          }
          const lum = sum / (data.length / 4);
          lumCache.set(img, lum);
          return lum;
        };

        let sideTicking = false;
        const updateSideInk = () => {
          sideTicking = false;
          const rect = gallerySideInner.getBoundingClientRect();
          if (rect.bottom < 0 || rect.top > window.innerHeight) return;
          const x = Math.max(1, Math.min(rect.left + rect.width / 2, window.innerWidth - 1));
          const y = Math.max(1, Math.min(rect.top + rect.height * 0.55, window.innerHeight - 1));
          const tile = document
            .elementsFromPoint(x, y)
            .find((el) => el.closest(".lp-tile"))
            ?.closest(".lp-tile");
          const img = tile?.querySelector("img");
          if (!img) return;
          const bg = luminanceOf(img);
          if (bg === null) return;
          gallerySide.classList.toggle("lp-side-dark", contrast(priLum, bg) > contrast(1, bg));
        };
        const requestSideInk = () => {
          if (!sideTicking) {
            sideTicking = true;
            requestAnimationFrame(updateSideInk);
          }
        };
        window.addEventListener("scroll", requestSideInk, { passive: true });
        window.addEventListener("resize", requestSideInk);
        // The phone gallery scrolls horizontally inside its own container.
        document
          .querySelector(".lp-gallery-scroll")
          ?.addEventListener("scroll", requestSideInk, { passive: true });
        requestSideInk();
      }

      // Gallery tiles: open in a new tab, and reveal the example/tutorial name
      // (reused from the image alt) at the bottom-right on hover.
      document.querySelectorAll<HTMLAnchorElement>("a.lp-tile").forEach((tile) => {
        tile.target = "_blank";
        tile.rel = "noopener noreferrer";
        const img = tile.querySelector("img");
        if (!img || !img.alt) return;
        const label = document.createElement("span");
        label.className = "lp-tile-title";
        label.textContent = img.alt;
        tile.appendChild(label);
      });

      // Resolves once every <img> inside the element is loaded and decoded
      // (errors resolve too, so a broken image can never block an entrance).
      // Elements without images resolve immediately.
      const imagesReady = (el: Element): Promise<unknown> =>
        Promise.all(
          Array.from(el.querySelectorAll("img"), (img) => img.decode().catch(() => {})),
        );

      // Longest entrance: max stagger delay (0.75s) + slowest transition
      // (2.8s photo settle), rounded up. will-change promotion is released
      // after this so entrances never compete with each other for layers.
      const REVEAL_MS = 4000;

      // Promote everything an entrance animates onto its own compositor
      // layer for the duration of the transition, so a busy main thread
      // (image decode, layout) cannot freeze it mid-flight. The promotion
      // is temporary: keeping dozens of full-bleed layers alive would cost
      // more than it saves.
      const playReveal = (el: Element): void => {
        const layered = [el, ...el.children, ...el.querySelectorAll("img")] as HTMLElement[];
        layered.forEach((t) => (t.style.willChange = "opacity, transform"));
        // Two frames so the promotion is committed before the transition starts.
        requestAnimationFrame(() =>
          requestAnimationFrame(() => el.classList.add("lp-revealed")),
        );
        setTimeout(() => layered.forEach((t) => (t.style.willChange = "")), REVEAL_MS);
      };

      // Reveal-on-scroll: elements marked data-reveal (observed individually)
      // and data-reveal-group containers (which gate their staggered children)
      // play their entrance once they cross the lower edge of the viewport and
      // every image inside them is ready, so nothing fades in half-rendered.
      // Hidden states only exist under prefers-reduced-motion: no-preference,
      // so for reduced motion the class toggle is a no-op.
      const revealEls = document.querySelectorAll("[data-reveal], [data-reveal-group]");
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              const el = entry.target;
              imagesReady(el).then(() => playReveal(el));
              revealObserver.unobserve(el);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px" },
      );
      revealEls.forEach((el) => revealObserver.observe(el));

      // Decode every landing-page image during idle time right after load, so
      // large decodes are spread out instead of bursting exactly when a
      // reveal (or a running entrance nearby) needs the main thread.
      const predecode = () =>
        document
          .querySelectorAll<HTMLImageElement>(".lp img")
          .forEach((img) => img.decode().catch(() => {}));
      "requestIdleCallback" in window
        ? requestIdleCallback(predecode, { timeout: 2000 })
        : setTimeout(predecode, 300);

      // API tier showcase: cross-fade the still through one scene per tier
      // and light the matching caption + ring label in sync. It auto-advances
      // while on screen (never under reduced motion); clicking a ring label
      // jumps to its tier and restarts the hold from there.
      const apiStage = document.querySelector<HTMLElement>(".lp-api-stage");
      if (apiStage) {
        const stills = Array.from(
          apiStage.querySelectorAll<HTMLElement>(".lp-api-media img"),
        );
        const caps = Array.from(
          apiStage.querySelectorAll<HTMLElement>(".lp-api-cap"),
        );
        const nodes = Array.from(
          apiStage.querySelectorAll<HTMLElement>(".lp-api-node"),
        );
        const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
        const TIER_HOLD_MS = 3600;
        let tier = 0;
        let tierTimer: number | undefined;
        const showTier = (i: number) => {
          tier = i;
          stills.forEach((img, j) => img.classList.toggle("lp-tier-visible", j === i));
          caps.forEach((cap, j) => cap.classList.toggle("lp-tier-active", j === i));
          nodes.forEach((node) =>
            node.classList.toggle("lp-tier-active", Number(node.dataset.tier) === i),
          );
        };
        const stopTiers = () => {
          if (tierTimer !== undefined) {
            clearInterval(tierTimer);
            tierTimer = undefined;
          }
        };
        const startTiers = () => {
          if (tierTimer === undefined && !reducedMotion.matches) {
            tierTimer = window.setInterval(
              () => showTier((tier + 1) % stills.length),
              TIER_HOLD_MS,
            );
          }
        };
        new IntersectionObserver(
          ([entry]) => (entry.isIntersecting ? startTiers() : stopTiers()),
          { threshold: 0.35 },
        ).observe(apiStage);
        nodes.forEach((node) =>
          node.addEventListener("click", () => {
            showTier(Number(node.dataset.tier));
            stopTiers();
            startTiers();
          }),
        );
      }

      // The hero opening also waits for its image, fading it in only once it
      // can be painted in full.
      const heroImg = document.querySelector<HTMLImageElement>(".lp-hero img");
      if (heroImg) {
        heroImg
          .decode()
          .catch(() => {})
          .then(() => {
            heroImg.style.willChange = "opacity, transform";
            heroImg.classList.add("lp-loaded");
            heroImg.addEventListener(
              "animationend",
              () => (heroImg.style.willChange = ""),
              { once: true },
            );
          });
      }
    </script>
    <noscript>
      <style>
        [data-reveal],
        [data-reveal-group] > * {
          opacity: 1 !important;
          transform: none !important;
        }
        [data-motion="img"] img {
          transform: none !important;
        }
        .lp-hero img {
          opacity: 1 !important;
        }
      </style>
    </noscript>

    <style is:global>
      :root {
        --ink: color-mix(in oklab, var(--pri), black 20%);
        --ink-soft: color-mix(in oklab, var(--pri), white 35%);
        --on-dark: color-mix(in oklab, var(--pri), white 88%);
        --on-dark-soft: color-mix(in oklab, var(--pri), white 60%);
        --line: color-mix(in oklab, var(--pri), white 85%);
        --line-dark: color-mix(in oklab, var(--pri), white 14%);
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: #fff;
        color: var(--ink);
        font-family: "Arsenal", "Zen Kaku Gothic New", sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .lp a {
        color: color-mix(in oklab, var(--acc), black 25%);
        text-decoration: none;
      }
      .lp a:hover {
        color: var(--acc);
      }
      /* Zero-specificity reset so per-section margin rules always win. */
      :where(.lp h1, .lp h2, .lp h3, .lp p) {
        margin: 0;
      }
      .lp img {
        display: block;
      }
      .lp-container {
        max-width: 1320px;
        margin: 0 auto;
      }

      /* Motion system — scroll-driven reveals.
         data-reveal: observed individually; data-reveal-group: the container
         is observed and its direct children stagger in DOM order. --rd is the
         stagger step (x 90ms), --rd-base shifts a whole group; both can be
         overridden inline for custom orders (e.g. the architecture diagram).
         data-motion variants: "img" = photo settle (frame fades, image scales
         down into place), "grow" = connectors growing upward. Everything is
         disabled under prefers-reduced-motion and, via <noscript>, without JS. */
      @media (prefers-reduced-motion: no-preference) {
        /* Page-load opening: the hero settles in, then the header drops in.
           The hero hides until JS marks its image as loaded (lp-loaded), so
           the fade always plays over the finished picture. The keyframes spell
           out the "to" state because the base state here is the hidden one. */
        @keyframes nv-hero-in {
          from {
            opacity: 0;
            transform: scale(1.045);
          }
          to {
            opacity: 1;
            transform: none;
          }
        }
        .lp-hero img {
          opacity: 0;
        }
        .lp-hero img.lp-loaded {
          animation: nv-hero-in 3s cubic-bezier(0.3, 0.5, 0.2, 1) both;
        }
        @keyframes nv-header-in {
          from {
            opacity: 0;
            transform: translateY(-10px);
          }
        }
        .lp-header {
          animation: nv-header-in 1.6s 0.8s cubic-bezier(0.3, 0.5, 0.2, 1) both;
        }

        [data-reveal],
        [data-reveal-group] > * {
          opacity: 0;
          transform: translateY(22px);
          /* Soft, airy feel: a long fade on a gentle ease-out, with an even
             longer drift so elements seem to breathe into place. */
          transition:
            opacity 1.4s cubic-bezier(0.3, 0.5, 0.2, 1),
            transform 1.8s cubic-bezier(0.3, 0.5, 0.2, 1);
          transition-delay: calc((var(--rd-base, 0) + var(--rd, 0)) * 150ms);
        }
        /* DOM-order stagger inside groups. :nth-child(1) is explicit so a
           nested group's first child does not inherit its parent's --rd. */
        [data-reveal-group] > :nth-child(1) {
          --rd: 0;
        }
        [data-reveal-group] > :nth-child(2) {
          --rd: 1;
        }
        [data-reveal-group] > :nth-child(3) {
          --rd: 2;
        }
        [data-reveal-group] > :nth-child(4) {
          --rd: 3;
        }
        [data-reveal-group] > :nth-child(5) {
          --rd: 4;
        }
        [data-reveal-group] > :nth-child(6) {
          --rd: 5;
        }
        /* Photo settle: the frame only fades while the image scales down into
           place (tiles clip the overshoot via overflow: hidden). */
        [data-motion="img"] {
          transform: none;
        }
        .lp [data-motion="img"] img {
          transform: scale(1.05);
          transition:
            transform 2.8s cubic-bezier(0.3, 0.5, 0.2, 1),
            filter 0.35s ease;
          transition-delay: calc((var(--rd-base, 0) + var(--rd, 0)) * 150ms), 0s;
        }
        /* Connectors grow upward, matching the core-first build order. */
        [data-motion="grow"] {
          transform: scaleY(0);
          transform-origin: bottom;
        }
        /* Revealed states last, so they win the equal-specificity ties. */
        [data-reveal].lp-revealed,
        .lp-revealed[data-reveal-group] > * {
          opacity: 1;
          transform: none;
        }
        .lp-revealed[data-motion="img"] img,
        .lp-revealed[data-reveal-group] > [data-motion="img"] img {
          transform: none;
        }
      }

      /* Header: always fixed; gains a dark backdrop once the hero is gone
         so the light sections keep it readable. */
      .lp-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 48px;
        background: linear-gradient(
          color-mix(in srgb, var(--pri) 45%, transparent),
          transparent
        );
        transition: background 0.3s ease;
      }
      .lp-header.lp-header-solid {
        background: color-mix(in srgb, var(--pri) 88%, transparent);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
      }
      .lp-wordmark {
        font: 700 22px "Arsenal", "Zen Kaku Gothic New", sans-serif;
        letter-spacing: 0.04em;
        color: var(--on-dark);
      }
      .lp-nav {
        display: flex;
        align-items: center;
        gap: 28px;
        font-size: 14px;
        font-weight: 500;
      }
      .lp .lp-nav a {
        color: var(--on-dark);
      }
      .lp .lp-nav a:hover {
        color: var(--acc);
      }
      .lp-nav-github svg {
        display: block;
        width: 20px;
        height: 20px;
      }
      .lp-nav-github svg path {
        fill: currentColor;
      }
      .lp-lang {
        position: relative;
        display: flex;
        align-items: center;
        gap: 7px;
        color: var(--on-dark);
        cursor: pointer;
      }
      .lp-lang:hover {
        color: var(--acc);
      }
      .lp-lang svg {
        display: block;
        flex: none;
      }
      .lp-lang select {
        appearance: none;
        background: transparent;
        border: none;
        color: inherit;
        /* Tall enough that Latin descenders are not clipped by the select box. */
        font: 500 13px/18px "Arsenal", "Zen Kaku Gothic New", sans-serif;
        height: 18px;
        padding: 0 16px 0 0;
        cursor: pointer;
      }
      /* Draw the focus ring around the whole switcher (icon + label + arrow). */
      .lp-lang select:focus-visible {
        outline: none;
      }
      .lp-lang:has(select:focus-visible) {
        outline: 1px solid var(--acc);
        outline-offset: 5px;
        border-radius: 2px;
      }
      /* Native dropdown list opens on a light background. */
      .lp-lang select option {
        color: var(--pri);
      }
      .lp-lang .lp-lang-chevron {
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
      }
      /* Inline arrow icons sit on the text baseline row of their link. */
      .lp .lp-getting-started a,
      .lp .lp-gallery-link a,
      .lp .lp-maplibre-roadmap a {
        display: inline-flex;
        align-items: center;
        gap: 3px;
      }
      .lp-link-icon {
        flex: none;
        /* Arsenal / Zen Kaku glyphs sit low in the em box; drop the icon to
           its optical center. */
        transform: translateY(1.5px);
      }
      .lp .lp-nav a.lp-nav-cta {
        color: var(--pri);
        background: var(--on-dark);
        padding: 8px 18px;
        border-radius: 6px;
        font-weight: 700;
      }
      .lp .lp-nav a.lp-nav-cta:hover {
        background: var(--acc);
        color: var(--pri);
      }

      /* Hero */
      .lp-hero-stage {
        position: relative;
      }
      /* Invisible scroll budget: while it is consumed, the hero and the
         fully revealed catch copy stay pinned, so the page appears to pause.
         Never shown as blank space — the pinned hero covers the viewport. */
      .lp-hero-stage::after {
        content: "";
        display: block;
        height: 40vh;
      }
      .lp-hero {
        /* Fill the first screen and stay pinned while the catch copy slides
           over it; the sticky range is bounded by .lp-hero-stage, so normal
           scrolling resumes once the catch copy is fully visible. */
        position: sticky;
        top: 0;
        /* svh keeps the pinned hero stable under mobile dynamic toolbars. */
        height: 100vh;
        height: 100svh;
        min-height: 480px;
        background: var(--pri);
      }
      .lp-hero img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .lp-main {
        position: relative;
        z-index: 1;
        background: #fff;
      }

      /* Catch copy + intro: transparent, overlaid on the hero image. Pins
         via sticky exactly when fully revealed (top = viewport height minus
         its own height, measured by script) and stays pinned until the
         stage's scroll budget is used up. */
      .lp-intro {
        position: sticky;
        top: calc(100vh - var(--lp-intro-h, 200vh));
        top: calc(100svh - var(--lp-intro-h, 200svh));
        z-index: 1;
        padding: 80px 48px 72px;
        /* Frosted-glass panel over the hero image. */
        background: color-mix(in srgb, var(--pri) 40%, transparent);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
      }
      .lp-intro-grid {
        display: grid;
        grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
        gap: 72px;
        align-items: start;
      }
      .lp-h1 {
        font: 700 68px/1.12 "Arsenal", "Zen Kaku Gothic New", sans-serif;
        letter-spacing: -0.01em;
